                                                  ContextMenu="{StaticResource RowMenu.Device}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[snmptrap.0]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[snmptrap.1]}" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Remote}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Text}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                    <TextBlock Style="{StaticResource EmptyHint}"
                                               Text="「開始」で待ち受けると、受信した Trap がここに出ます"
                                               Visibility="{Binding Items.Count, ElementName=TrapLogList, Converter={StaticResource ZeroToVisible}}" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 収集（Cisco 機器へ入って show の出力を集める） ===== -->
            <TabItem Tag="NW機器" x:Name="CollectTab" Header="ログ採取" DataContext="{Binding Collect}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="{x:Static help:TabHelp.Collect}" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="Cisco 機器に入って、show の出力をまとめて集めます。" />
                        </DockPanel>

                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button Content="宛先リストから選ぶ" Command="{Binding ImportFromTargetsCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                    ToolTip="Ping と TCP のタブに登録してある宛先から、取り込む相手を選びます。" />
                            <Button Content="CSV から取り込む" Command="{Binding ImportCsvCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                    ToolTip="機器の一覧を CSV ファイルから読み込みます。書き方は「CSV のひな型を保存」で確かめられます。" />
                            <Button Content="CSV のひな型を保存" Command="{Binding SaveCsvTemplateCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                    ToolTip="取り込みに使う CSV のひな型(書き方の見本つき)をファイルに書き出します。Excel でそのまま開けます。" />
                            <Button Content="全行に認証情報を入れる..." Click="OnCollectFillCredentials"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,16,2"
                                    ToolTip="一覧の全行に、同じユーザー名・パスワード・enable を一度に入れます(共通の TACACS+/AD の現場向け)。保存はしません。" />

                            <!-- 機種。コマンド欄の上に置いていたが窓が狭いと目に入らないので、
                                 他の設定と同じこの行へ出す -->
                            <TextBlock Text="機種" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,5,2" />
                            <ComboBox Width="120" Margin="0,0,16,2"
                                      ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      ToolTip="選ぶとコマンド欄をその機種のおすすめで置き換えます。既定は IOS / IOS-XE です。">
                                <!-- 閉じているときの表示に DisplayMemberPath は効かない -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="コマンドを既定に戻す" Command="{Binding ResetCommandsCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,16,2"
                                    ToolTip="コマンド欄を、選んでいる機種のおすすめに戻します。書き換えた内容は消えます。" />

                            <TextBlock Text="接続の待ち" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,4,2" />
                            <TextBox Width="40" Text="{Binding ConnectSeconds}" Margin="0,0,2,2"
                                     ToolTip="機器につながるまで待つ時間です。この時間を過ぎたら、その機器は諦めて次へ進みます。" />
                            <TextBlock Text="秒" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,12,2" />

                            <TextBlock Text="応答の待ち" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,4,2" />
                            <TextBox Width="40" Text="{Binding IdleSeconds}" Margin="0,0,2,2"
                                     ToolTip="コマンドを送った後、出力が途切れてから諦めるまでの時間です。長い show でも出力が続いている間は待ち続けます。" />
                            <TextBlock Text="秒" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,16,2" />

                            <Button Content="収集を開始" Command="{Binding StartCommand}" Margin="0,0,6,2" />
                            <Button Content="失敗した機器だけ再実行" Command="{Binding RetryFailedCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                    ToolTip="✕ 失敗と ⛔ パスワード未入力の行だけを、もう一度収集します。成功した機器へは接続しません。&#10;パスワードは収集のたびに消える決まりなので、先に入れ直してください（「全行に認証情報を入れる」が速い）。" />
                            <Button Content="中断" Command="{Binding CancelCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2" />
                            <Button Content="保存先を開く" Command="{Binding OpenFolderCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,0,2" />
                        </WrapPanel>
                        <ProgressBar DockPanel.Dock="Top" Style="{StaticResource BusyBar}" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock DockPanel.Dock="Top" Text="{Binding Notice}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Brush.Warn.Fg}"
                                   Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <DockPanel>
                            <!-- 上: 機器（1 台 1 行の表。書式を人に覚えてもらわない） -->
                            <Border DockPanel.Dock="Top" MaxHeight="300"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                <DockPanel>
                                    <!-- 見出し。どの欄に何を入れるかはここで示す -->
                                    <Grid DockPanel.Dock="Top" Margin="4,0,18,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.0]}" />
                                            <ColumnDefinition Width="*" MinWidth="150" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.2]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.3]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.4]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.5]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.6]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.7]}" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                        <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="5" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="6" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <TextBlock Grid.Column="0" Text="削除" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="1" Text="機器のアドレス" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="2" Text="接続方法" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="3" Text="ユーザー名" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="4" Text="パスワード" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="5" Text="enable" Style="{StaticResource Caption}"
                                                   ToolTip="特権モードに入るためのパスワード。要らない機器は空のままで構いません。" />
                                        <TextBlock Grid.Column="6" Text="備考" Style="{StaticResource Caption}"
                                                   ToolTip="宛先リストから取り込むと、宛先に書いてある備考がそのまま入ります。" />
                                        <TextBlock Grid.Column="7" Text="状態" Style="{StaticResource Caption}" />

                                        <!-- 列幅のつまみ。星列(1)より左は右端、右は左端の境界に置く -->
                                        <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                               Tag="collect.0" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="collect.2" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="collect.3" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="4" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="collect.4" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="5" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="collect.5" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="6" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="collect.6" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="7" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="collect.7" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                    </Grid>
                                    <Border DockPanel.Dock="Top" Height="1"
                                            Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />

                                    <!--
                                        この一覧だけ仮想化を切る。行コンテナを使い回すと、
                                        PasswordBox はバインドを持たないので DataContext が変わっても
                                        中身が入れ替わらず、スクロールしただけで別の機器の欄に
                                        前の機器のパスワードが載る(そのまま送信されうる)。
                                        機器は多くても数十台なので実害は無い。
                                    -->
                                    <!--
                                        「行を追加」を先に下端へ留めてから、一覧に残りを埋めさせる。
                                        逆にして一覧を先に置くと、行が増えたときに一覧が高さを
                                        取り切ってボタンのぶんが残らず、押せなくなる(実際に起きた)。
                                        枠は中身なりの高さになるので、行が少ないときは
                                        ボタンが最後の行のすぐ下に来る。
                                    -->
                                    <Button x:Name="CollectAddRow" DockPanel.Dock="Bottom" Content="＋ 行を追加"
                                            Command="{Binding AddDeviceCommand}"
                                            Style="{StaticResource Button.Subtle}"
                                            HorizontalAlignment="Left"
                                            Margin="4,4,0,0" />

                                    <Grid>
                                    <ListBox x:Name="CollectDeviceList" ItemsSource="{Binding Rows}"
                                             Background="Transparent" BorderThickness="0"
                                             HorizontalContentAlignment="Stretch"
                                             ItemContainerStyle="{StaticResource PlainRowContainer}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="False"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="{DynamicResource Size.RowHeight.Input}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.0]}" />
                                                        <ColumnDefinition Width="*" MinWidth="150" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.2]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.3]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.4]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.5]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.6]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.7]}" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                    <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="5" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="6" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />

                                                    <!-- 行そのものを引数で渡す(どの行の × かを VM に伝える) -->
                                                    <Button Grid.Column="0" Content="✕"
                                                            Style="{StaticResource Button.Subtle}"
                                                            Command="{Binding DataContext.RemoveDeviceCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            Width="16" Height="16"
                                                            Padding="0" MinWidth="0" MinHeight="0"
                                                            FontSize="{DynamicResource Size.Micro}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center" Margin="2,0,0,0"
                                                            ToolTip="この行を消します。" />

                                                    <TextBox Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                                             FontFamily="{DynamicResource Font.Mono}"
                                                             FontSize="{DynamicResource Size.Caption}"
                                                             Margin="0,0,4,0" VerticalAlignment="Center"
                                                             ToolTip="機器の IP かホスト名。" />

                                                    <ComboBox Grid.Column="2"
                                                              ItemsSource="{Binding Methods}"
                                                              SelectedItem="{Binding Method}"
                                                              FontSize="{DynamicResource Size.Caption}"
                                                              VerticalAlignment="Center" Margin="0,0,4,0"
                                                              ToolTip="つなぎ方。ポートは方式に応じて 22 / 23 を使います。">
                                                        <!-- 閉じているときの表示に DisplayMemberPath は効かない -->
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <TextBox Grid.Column="3" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="{DynamicResource Size.Caption}"
                                                             Margin="0,0,4,0" VerticalAlignment="Center"
                                                             ToolTip="ログインするユーザー名。次回も覚えています。" />

                                                    <PasswordBox Grid.Column="4" Tag="login"
                                                                 PasswordChanged="OnCollectPasswordChanged"
                                                                 Margin="0,0,4,0" VerticalAlignment="Center"
                                                                 ToolTip="ログインのパスワード。保存しません（毎回入力）。" />

                                                    <PasswordBox Grid.Column="5" Tag="enable"
                                                                 PasswordChanged="OnCollectPasswordChanged"
                                                                 Margin="0,0,4,0" VerticalAlignment="Center"
                                                                 ToolTip="enable のパスワード。要らない機器は空のままで構いません。" />

                                                    <TextBox Grid.Column="6" Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="{DynamicResource Size.Caption}"
                                                             Margin="0,0,4,0" VerticalAlignment="Center"
                                                             ToolTip="機器の覚え書き。集めたファイルの先頭にも書き出されます。" />

                                                    <TextBlock Grid.Column="7" Text="{Binding Status}"
                                                               Style="{StaticResource ExpandableCell}"
                                                               FontSize="{DynamicResource Size.Caption}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Status}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                        <TextBlock Style="{StaticResource EmptyHint}"
                                                   Text="「宛先リストから選ぶ」か「＋ 行を追加」で機器を足してください"
                                                   Visibility="{Binding Items.Count, ElementName=CollectDeviceList, Converter={StaticResource ZeroToVisible}}" />
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <!-- 下: コマンド。窓が狭いと横並びでは入りきらないので縦に積む -->
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,3"
                                           Text="{Binding CommandSummary}" Style="{StaticResource Caption}" />

                                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding BlockedCommands}"
                                              Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource Brush.Warn.Fg}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBox Text="{Binding CommandText, UpdateSourceTrigger=LostFocus}"
                                         FontFamily="{DynamicResource Font.Mono}"
                                         FontSize="{DynamicResource Size.Caption}"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         ToolTip="1 行 1 コマンド。打つ順に並べます。" />
                            </DockPanel>
                        </DockPanel>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== パース(Cisco コマンド出力 → CSV) ===== -->
            <TabItem Tag="NW機器" Header="showコマンド整形" DataContext="{Binding Converter}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="{x:Static help:TabHelp.Convert}" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="機器のコマンド出力を貼り付けて Excel / CSV に変換します。" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="種別" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox Width="180"
                                      ItemsSource="{Binding Modes}"
                                      SelectedItem="{Binding SelectedMode}"
                                      Margin="0,0,12,0"
                                      ToolTip="貼り付けたコマンドの種類。自動判定で決まらないときはここで選びます。">
                                <!-- 閉じているときの表示に DisplayMemberPath は効かないので ItemTemplate を明示する -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Excel で保存" Command="{Binding SaveXlsxCommand}" Margin="0,0,6,0"
                                    ToolTip="絞り込み(オートフィルタ)と見出し行の固定を付けた .xlsx で保存します。" />
                            <Button Content="CSV で保存" Command="{Binding SaveCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,0"
                                    ToolTip="BOM 付き UTF-8 のテキスト。書式は付きません。" />
                            <Button Content="コピー" Command="{Binding CopyCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,12,0"
                                    ToolTip="CSV テキストをクリップボードへコピーします。" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 貼り付け欄。Cisco の出力は長いので折り返さず横スクロール -->
                            <TextBox Grid.Row="0"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}"
                                     FontSize="{DynamicResource Size.Caption}"
                                     AcceptsReturn="True" AcceptsTab="False"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     AllowDrop="True"
                                     PreviewDragOver="OnTextDragOver" Drop="OnTextDrop"
                                     ToolTip="show ip route / show interfaces status などの出力をそのまま貼り付けます。ファイルを放り込んでも読み込めます。" />

                            <TextBlock Grid.Row="1" Text="CSV プレビュー" Style="{StaticResource Caption}" Margin="0,6,0,3" />

                            <TextBox Grid.Row="2"
                                     Text="{Binding Preview, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="{DynamicResource Font.Mono}"
                                     FontSize="{DynamicResource Size.Caption}"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" />
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== ファイル転送（FTP / SFTP のクライアント。2 ペイン） ===== -->
            <TabItem Tag="NW機器" x:Name="TransferTab" Header="ファイル転送" DataContext="{Binding Transfer}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="{x:Static help:TabHelp.Transfer}" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="FTP / SFTP のサーバへ繋いで、ファイルを取ってくる・置いてくる。" />
                        </DockPanel>

                        <!-- 接続先 -->
                        <!-- 畳めるログイン欄。取れたら畳んで、一覧に画面を使う。
                             DockPanel.Dock を書かないと左端に立って、以降が丸ごと右へずれる -->
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                            <Button Content="{Binding ConnectionToggleText}" Command="{Binding ToggleConnectionCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,8,0"
                                    ToolTip="接続先の入力欄を開いたり畳んだりします。" />
                            <TextBlock Text="{Binding ConnectionSummary}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </WrapPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding ShowConnection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="接続先" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="150" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}" Margin="0,0,10,0"
                                     ToolTip="サーバや機器の IP、またはホスト名。">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ConnectCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <RadioButton Content="SFTP" IsChecked="{Binding IsSftp}" GroupName="XferKind"
                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                         ToolTip="SSH の上で運ぶ。経路が暗号化される。" />
                            <RadioButton Content="FTP" IsChecked="{Binding IsFtp}" GroupName="XferKind"
                                         VerticalAlignment="Center" Margin="0,0,10,0"
                                         ToolTip="暗号化されない。古い機器はこちらしか持っていないことがある。" />
                            <TextBlock Text="ポート" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="52" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}" Margin="0,0,10,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ConnectCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="ユーザー" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="110" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,10,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ConnectCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="パスワード" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <!-- TextBox にしない。F12 の画面保存に平文が焼き込まれる -->
                            <PasswordBox Width="110" Tag="xfer" PasswordChanged="OnFileServerPasswordChanged"
                                         Height="{DynamicResource Size.RowHeight.Input}" Margin="0,0,10,0"
                                         ToolTip="保存しません。閉じると消えます。">
                                <PasswordBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ConnectCommand}" />
                                </PasswordBox.InputBindings>
                            </PasswordBox>
                            <Button Content="接続" Command="{Binding ConnectCommand}" Margin="0,0,6,0" />
                            <Button Content="切断" Command="{Binding DisconnectCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,0" />
                            <Button Content="中断" Command="{Binding CancelCommand}"
                                    Style="{StaticResource Button.Subtle}"
                                    ToolTip="いま走っている転送を止めます。" />
                        </StackPanel>

                        <!-- 状態と鍵の指紋。証跡として残せるよう選択可にする -->
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBox DockPanel.Dock="Top" Text="{Binding Fingerprint, Mode=OneWay}"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 FontFamily="{DynamicResource Font.Mono}"
                                 FontSize="{DynamicResource Size.Caption}"
                                 Foreground="{DynamicResource Brush.TextMuted}"
                                 Margin="0,0,0,6"
                                 ToolTip="繋いだ相手のホスト鍵の指紋。前と違っていたら、相手が入れ替わっている疑いがあります。">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <!-- FTP には鍵が無いので、空のときは行ごと畳む -->
                                        <DataTrigger Binding="{Binding Fingerprint}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- 進捗。転送していないときは畳んで場所を空ける -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <!-- RangeBase.Value は既定が TwoWay。読み取り専用プロパティに繋ぐので OneWay を明示する -->
                            <ProgressBar Style="{StaticResource BusyBar}" Margin="0"
                                         Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" />
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- 操作のボタン。ドラッグ＆ドロップは作らない（この幅では狙いにくく誤操作が怖い） -->
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="→ 送る" Command="{Binding UploadCommand}" Margin="0,0,6,0"
                                    ToolTip="左で選んだファイルを、右のいまの場所へ置きます。" />
                            <Button Content="← 取ってくる" Command="{Binding DownloadCommand}" Margin="0,0,16,0"
                                    ToolTip="右で選んだファイルを、左のいまの場所へ持ってきます。" />
                            <Button Content="新しいフォルダ" Command="{Binding MakeDirectoryCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,0" />
                            <Button Content="名前を変更" Command="{Binding RenameCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,0" />
                            <Button Content="削除" Command="{Binding DeleteCommand}"
                                    Style="{StaticResource Button.Subtle}"
                                    ToolTip="接続先のファイルを消します。元に戻せません。" />
                        </StackPanel>

                        <!-- 2 ペイン。左がこの PC、右が接続先 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="150" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" MinWidth="150" />
                            </Grid.ColumnDefinitions>

                            <Thumb Grid.Column="1" Style="{StaticResource PaneGrip.V}" DragStarted="OnPaneGrab" DragDelta="OnPaneDrag" />

                            <!-- ===== 左: この PC ===== -->
                            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                                        <TextBlock DockPanel.Dock="Left" Text="この PC" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Button DockPanel.Dock="Right" Content="更新" Command="{Binding RefreshLocalCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="6,0,0,0" />
                                        <TextBox Text="{Binding LocalPath, UpdateSourceTrigger=LostFocus}"
                                                 FontFamily="{DynamicResource Font.Mono}"
                                                 FontSize="{DynamicResource Size.Caption}"
                                                 ToolTip="場所を直接書き換えて Tab を押すと移れます。" />
                                    </DockPanel>

                                    <Grid DockPanel.Dock="Top" Margin="4,0,18,3" Background="Transparent" Tag="local" MouseLeftButtonDown="OnTableHeaderSort"
                                      Cursor="Hand" ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[local.0]}" />
                                            <ColumnDefinition Width="*" MinWidth="90" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[local.2]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[local.3]}" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <TextBlock Grid.Column="1" Text="名前"     Style="{StaticResource Caption}" Margin="6,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="サイズ"   Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="3" Text="更新日時" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                                        <!-- 列幅のつまみ。星列より左は右端、右は左端の境界に置く -->
                                        <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                               Tag="local.0" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="local.2" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="local.3" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                    </Grid>
                                    <Border DockPanel.Dock="Top" Height="1"
                                            Background="{DynamicResource Brush.Border}" Margin="0,0,0,2" />

                                    <ListBox ItemsSource="{Binding LocalRows}" Tag="local"
                                             SelectedItem="{Binding SelectedLocal}"
                                             ItemContainerStyle="{StaticResource PlainRowContainer}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             HorizontalContentAlignment="Stretch"
                                             MouseDoubleClick="OnLocalFileOpen"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                                             ScrollViewer.VerticalScrollBarVisibility="Visible">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="{DynamicResource Size.RowHeight}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[local.0]}" />
                                                        <ColumnDefinition Width="*" MinWidth="90" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[local.2]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[local.3]}" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                               Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Mono}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Style="{StaticResource Mono}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- ===== 右: 接続先 ===== -->
                            <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}"
                                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                                        <TextBlock DockPanel.Dock="Left" Text="接続先" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Button DockPanel.Dock="Right" Content="更新" Command="{Binding RefreshRemoteCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="6,0,0,0" />
                                        <TextBox Text="{Binding RemotePathText, Mode=OneWay}" IsReadOnly="True"
                                                 FontFamily="{DynamicResource Font.Mono}"
                                                 FontSize="{DynamicResource Size.Caption}"
                                                 ToolTip="いま見ている場所。フォルダをダブルクリックして移ります。" />
                                    </DockPanel>

                                    <Grid DockPanel.Dock="Top" Margin="4,0,18,3" Background="Transparent" Tag="remote" MouseLeftButtonDown="OnTableHeaderSort"
                                      Cursor="Hand" ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[remote.0]}" />
                                            <ColumnDefinition Width="*" MinWidth="90" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[remote.2]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[remote.3]}" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <TextBlock Grid.Column="1" Text="名前"     Style="{StaticResource Caption}" Margin="6,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="サイズ"   Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="3" Text="更新日時" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                                        <!-- 列幅のつまみ。星列より左は右端、右は左端の境界に置く -->
                                        <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                               Tag="remote.0" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="remote.2" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="remote.3" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                    </Grid>
                                    <Border DockPanel.Dock="Top" Height="1"
                                            Background="{DynamicResource Brush.Border}" Margin="0,0,0,2" />

                                    <ListBox ItemsSource="{Binding RemoteRows}" Tag="remote"
                                             SelectedItem="{Binding SelectedRemote}"
                                             ItemContainerStyle="{StaticResource PlainRowContainer}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             HorizontalContentAlignment="Stretch"
                                             MouseDoubleClick="OnRemoteFileOpen"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                                             ScrollViewer.VerticalScrollBarVisibility="Visible">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="{DynamicResource Size.RowHeight}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[remote.0]}" />
                                                        <ColumnDefinition Width="*" MinWidth="90" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[remote.2]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[remote.3]}" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                               Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Mono}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Style="{StaticResource Mono}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== SNMP（GET / ウォーク） ===== -->
            <TabItem Tag="NW機器" x:Name="SnmpTab" Header="SNMP Get" DataContext="{Binding SnmpGet}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="{x:Static help:TabHelp.SnmpGet}" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="機器の値を SNMP で問い合わせます。" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="宛先" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="140" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}" Margin="0,0,12,0"
                                     ToolTip="機器の IP。">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding GetCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="コミュニティ" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="90" Text="{Binding Community, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,12,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding GetCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <CheckBox Content="v2c" IsChecked="{Binding IsV2c}"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      ToolTip="外すと v1 で問い合わせます。" />
                            <Button Content="取得" Command="{Binding GetCommand}" Margin="0,0,6,0" />
                            <Button Content="ウォーク" Command="{Binding WalkCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,0" />
                            <Button Content="中断" Command="{Binding CancelCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,0"
                                    ToolTip="ウォークは最大 5000 行まで走ります。" />
                            <Button Content="CSV で保存" Command="{Binding SaveCommand}"
                                    Style="{StaticResource Button.Subtle}" />
                        </StackPanel>
                        <ProgressBar DockPanel.Dock="Top" Style="{StaticResource BusyBar}" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="OID" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="240" Text="{Binding OidText, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}" Margin="0,0,8,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding GetCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <ComboBox Width="220"
                                      ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      ToolTip="よく使う OID を選ぶと上の欄に入ります。" />
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="4,0,18,3" Background="Transparent" Tag="snmpget" MouseLeftButtonDown="OnTableHeaderSort"
                                      Cursor="Hand" ToolTip="クリックで並べ替え（もう一度で逆順）">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[snmpget.0]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[snmpget.1]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[snmpget.2]}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <TextBlock Grid.Column="0" Text="OID" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="名前" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="2" Text="型" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="3" Text="値" Style="{StaticResource Caption}" />
                                    <!-- 列幅のつまみ。星列より左は右端、右は左端の境界に置く -->
                                    <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="snmpget.0" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="snmpget.1" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="snmpget.2" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                </Grid>
                                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />
                                <Grid>
                                <ListBox x:Name="SnmpGetList" ItemsSource="{Binding Rows}"
                                         Style="{StaticResource TargetListBox}"
                                         ItemContainerStyle="{StaticResource PlainRowContainer}"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.VerticalScrollBarVisibility="Visible">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="{DynamicResource Size.RowHeight}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[snmpget.0]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[snmpget.1]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[snmpget.2]}" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <TextBlock Grid.Column="0" Text="{Binding Oid}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Type}" Style="{StaticResource Caption}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Value}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                    <TextBlock Style="{StaticResource EmptyHint}"
                                               Text="「取得」を押すと、OID と値がここに並びます"
                                               Visibility="{Binding Items.Count, ElementName=SnmpGetList, Converter={StaticResource ZeroToVisible}}" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== ACI(APIC の REST から読むだけ) ===== -->
            <TabItem Tag="NW機器" x:Name="AciTab" Header="ACI" DataContext="{Binding Aci}">
                <DockPanel>
                    <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                   ToolTip="{x:Static help:TabHelp.Aci}" />
                        <TextBlock Style="{StaticResource TabIntro}" Text="APIC からファブリックの状態を読み取ります。" />
                    </DockPanel>

                    <!-- 操作行はサブタブ共通。パスワードは伏せ字（画面を PNG 保存できるため） -->
                    <StackPanel DockPanel.Dock="Top" Margin="2,2,0,6">
                        <!-- 畳めるログイン欄。取れたら畳んで、一覧に画面を使う -->
                        <WrapPanel Margin="0,0,0,2">
                            <Button Content="{Binding ConnectionToggleText}" Command="{Binding ToggleConnectionCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,8,0"
                                    ToolTip="接続先の入力欄を開いたり畳んだりします。" />
                            <TextBlock Text="{Binding ConnectionSummary}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </WrapPanel>
                        <WrapPanel Visibility="{Binding ShowConnection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="APIC" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,5,2" />
                            <!-- 素のテキスト欄。ComboBox の IsEditable はこのアプリでは使えない
                                 （テンプレートに PART_EditableTextBox が無く、入力欄が描かれない） -->
                            <TextBox Width="200" Margin="0,0,12,2"
                                     Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="APIC の IP かホスト名。https:// は付けても付けなくても構いません。前回の接続先が入っています。">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding FetchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <TextBlock Text="ユーザー" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,5,2" />
                            <TextBox Width="110" Margin="0,0,12,2"
                                     Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="読み取りだけできるユーザーで十分です。">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding FetchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <TextBlock Text="パスワード" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,5,2" />
                            <PasswordBox x:Name="AciPasswordBox" Width="130" Margin="0,0,12,2"
                                         PasswordChanged="OnAciPasswordChanged"
                                         ToolTip="保存しません。起動するたびに入れ直してください。">
                                <PasswordBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding FetchCommand}" />
                                </PasswordBox.InputBindings>
                            </PasswordBox>

                            <Button Content="取得" Command="{Binding FetchCommand}" Margin="0,0,6,2" />
                            <Button Content="中断" Command="{Binding CancelCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2" />
                            <!-- APIC の版によって属性名が違うことがある。実機で切り分けるための逃げ道 -->
                            <Button Content="応答を表示" Click="OnAciShowResponse"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,0,2"
                                    ToolTip="直前に取れた生の応答(JSON)を出します。表が空のときの切り分け用です。" />
                        </WrapPanel>
                        <ProgressBar DockPanel.Dock="Top" Style="{StaticResource BusyBar}" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource Brush.Warn.Fg}" TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Fingerprint}" Style="{StaticResource Mono}"
                                   FontSize="{DynamicResource Size.Caption}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                   ToolTip="接続した APIC の証明書の指紋。APIC の画面と見比べるためのものです。"
                                   Visibility="{Binding ShowConnection, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- 中の切り替えも主タブと同じ見た目にする（Meraki と同じ扱い） -->
                    <TabControl x:Name="AciSubTabs" BorderThickness="0" Padding="0">

                        <!-- ヘルス -->
                        <TabItem Header="ヘルス">
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                                   ToolTip="{x:Static help:TabHelp.AciHealth}" />
                                        <TextBlock Style="{StaticResource TabIntro}" Text="ファブリック・ノード・テナントの健全度を並べます。" />
                                    </DockPanel>

                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="ファブリック全体" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding FabricHealth}" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource Size.Heading}" Margin="0,0,16,0" />
                                        <Button Content="Excel で保存" Command="{Binding SaveXlsxCommand}"
                                                CommandParameter="health" Margin="0,0,6,0"
                                                ToolTip="絞り込みと見出し行の固定を付けた .xlsx で保存します。" />
                                        <Button Content="CSV で保存" Command="{Binding SaveCsvCommand}"
                                                CommandParameter="health" Style="{StaticResource Button.Subtle}" />
                                    </StackPanel>

                                    <Border Background="{DynamicResource Brush.Surface}"
                                            BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                            CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" Margin="4,0,18,3" Background="Transparent" Tag="acihl" MouseLeftButtonDown="OnTableHeaderSort"
                                      Cursor="Hand" ToolTip="クリックで並べ替え（もう一度で逆順）">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[acihl.0]}" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[acihl.2]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[acihl.3]}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <TextBlock Grid.Column="0" Text="種別" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="1" Text="名前" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="2" Text="スコア" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="3" Text="状態" Style="{StaticResource Caption}" />
                                                <!-- 星列より左は右端、右は左端の境界につまみを置く -->
                                                <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                                       Tag="acihl.0" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                                <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                                       Tag="acihl.2" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                                <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                                       Tag="acihl.3" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                            </Grid>
                                            <Border DockPanel.Dock="Top" Height="1"
                                                    Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />

                                            <ListBox ItemsSource="{Binding HealthRows}"
                                                     ItemContainerStyle="{StaticResource PlainRowContainer}"
                                                     Background="Transparent" BorderThickness="0"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                     ScrollViewer.VerticalScrollBarVisibility="Visible">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="{DynamicResource Size.RowHeight.Wide}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[acihl.0]}" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[acihl.2]}" />
                                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[acihl.3]}" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                            <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                            <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                            <TextBlock Grid.Column="0" Text="{Binding Kind}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ScoreText}" Style="{StaticResource Mono}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right" Margin="0,0,10,0" />
                                                            <TextBlock Grid.Column="3" Text="{Binding State}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding StateKind}" Value="Ok">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StateKind}" Value="Notice">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StateKind}" Value="Alert">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>
                                </DockPanel>
                            </Border>
                        </TabItem>

                        <!-- Faults -->
                        <TabItem Header="フォールト">
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                                   ToolTip="{x:Static help:TabHelp.AciFaults}" />
                                        <TextBlock Style="{StaticResource TabIntro}" Text="いま出ている障害を重い順に並べます。" />
                                    </DockPanel>

                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="Excel で保存" Command="{Binding SaveXlsxCommand}"
                                                CommandParameter="faults" Margin="0,0,6,0"
                                                ToolTip="絞り込みと見出し行の固定を付けた .xlsx で保存します。" />
                                        <Button Content="CSV で保存" Command="{Binding SaveCsvCommand}"
                                                CommandParameter="faults" Style="{StaticResource Button.Subtle}" />
                                    </StackPanel>

                                    <Border Background="{DynamicResource Brush.Surface}"
                                            BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                            CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" Margin="4,0,18,3" Background="Transparent" Tag="aciflt" MouseLeftButtonDown="OnTableHeaderSort"
                                      Cursor="Hand" ToolTip="クリックで並べ替え（もう一度で逆順）">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciflt.0]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciflt.1]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciflt.2]}" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciflt.4]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciflt.5]}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <TextBlock Grid.Column="0" Text="重大度" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="1" Text="コード" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="2" Text="発生" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="3" Text="対象" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="4" Text="説明" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="5" Text="確認" Style="{StaticResource Caption}" />
                                                <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                                       Tag="aciflt.0" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                                <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                                       Tag="aciflt.1" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                                <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                                       Tag="aciflt.2" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                                <Thumb Grid.Column="4" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                                       Tag="aciflt.4" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                                <Thumb Grid.Column="5" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                                       Tag="aciflt.5" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                            </Grid>
                                            <Border DockPanel.Dock="Top" Height="1"
                                                    Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />

                                            <ListBox ItemsSource="{Binding FaultRows}"
                                                     ItemContainerStyle="{StaticResource PlainRowContainer}"
                                                     Background="Transparent" BorderThickness="0"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                     ScrollViewer.VerticalScrollBarVisibility="Visible">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="{DynamicResource Size.RowHeight.Wide}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciflt.0]}" />
                                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciflt.1]}" />
                                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciflt.2]}" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciflt.4]}" />
                                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciflt.5]}" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                            <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                            <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                            <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                            <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                            <TextBlock Grid.Column="0" Text="{Binding Severity}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SeverityKind}" Value="Ok">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding SeverityKind}" Value="Notice">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding SeverityKind}" Value="Alert">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="1" Text="{Binding Code}" Style="{StaticResource Mono}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Created}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Target}" Style="{StaticResource Mono}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Target}" />
                                                            <TextBlock Grid.Column="4" Text="{Binding Description}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Description}" />
                                                            <TextBlock Grid.Column="5" Text="{Binding Ack}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>
                                </DockPanel>
                            </Border>
                        </TabItem>


                        <TabItem Header="ポート">
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                                   ToolTip="{x:Static help:TabHelp.AciPorts}" />
                                        <TextBlock Style="{StaticResource TabIntro}" Text="選んだノードの物理ポートの状態と、割り当てを並べます。" />
                                    </DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="ノード" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <ComboBox Width="200" Margin="0,0,6,0"
                                                  ItemsSource="{Binding Nodes}"
                                                  SelectedItem="{Binding SelectedNode}"
                                                  ToolTip="ヘルスを取得すると、ここにノードが並びます。">
                                            <!-- 閉じているときの表示に DisplayMemberPath は効かない -->
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="ポートを取得" Command="{Binding FetchPortsCommand}" Margin="0,0,12,0" />
                                        <Button Content="Excel で保存" Command="{Binding SaveXlsxCommand}"
                                                CommandParameter="ports" Margin="0,0,6,0"
                                                ToolTip="絞り込みと見出し行の固定を付けた .xlsx で保存します。" />
                                        <Button Content="CSV で保存" Command="{Binding SaveCsvCommand}"
                                                CommandParameter="ports" Style="{StaticResource Button.Subtle}" Margin="0,0,12,0" />
                                    </StackPanel>
                                <Border Background="{DynamicResource Brush.Surface}"
                                        BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                        CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="4,0,18,3" Background="Transparent" Tag="aciport" MouseLeftButtonDown="OnTableHeaderSort"
                                      Cursor="Hand" ToolTip="クリックで並べ替え（もう一度で逆順）">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciport.0]}" />
                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciport.1]}" />
                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciport.2]}" />
                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciport.3]}" />
                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciport.4]}" />
                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciport.5]}" />
                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciport.6]}" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciport.8]}" />
                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciport.9]}" />
                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[aciport.10]}" />
                                            </Grid.ColumnDefinitions>
