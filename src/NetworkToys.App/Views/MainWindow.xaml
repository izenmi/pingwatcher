                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[acibd.2]}" />
                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[acibd.3]}" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[acibd.5]}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                            <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                            <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                            <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                            <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                            <TextBlock Grid.Column="0" Text="テナント" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="1" Text="ブリッジドメイン" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="2" Text="VRF" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="3" Text="ルーティング" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="4" Text="サブネット" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="5" Text="知らない宛先" Style="{StaticResource Caption}" />
                                            <!-- 星列より左は右端、右は左端の境界につまみを置く -->
                                            <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                                   Tag="acibd.0" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                            <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                                   Tag="acibd.1" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                            <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                                   Tag="acibd.2" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                            <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                                   Tag="acibd.3" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                            <Thumb Grid.Column="5" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                                   Tag="acibd.5" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        </Grid>
                                        <Border DockPanel.Dock="Top" Height="1"
                                                Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />
                                        <ListBox ItemsSource="{Binding BdRows}"
                                                 ItemContainerStyle="{StaticResource PlainRowContainer}"
                                                 Background="Transparent" BorderThickness="0"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 ScrollViewer.VerticalScrollBarVisibility="Visible">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                            <Grid Height="{DynamicResource Size.RowHeight.Wide}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[acibd.0]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[acibd.1]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[acibd.2]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[acibd.3]}" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[acibd.5]}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <TextBlock Grid.Column="0" Text="{Binding Tenant}"
                                                           FontSize="{DynamicResource Size.Caption}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           FontSize="{DynamicResource Size.Caption}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Vrf}"
                                                           FontSize="{DynamicResource Size.Caption}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding Routing}"
                                                           FontSize="{DynamicResource Size.Caption}"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RoutingKind}" Value="Ok">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="4" Text="{Binding Subnets}"
                                                           Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subnets}" />
                                                <TextBlock Grid.Column="5" Text="{Binding L2Unknown}"
                                                           FontSize="{DynamicResource Size.Caption}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                                </DockPanel>
                            </Border>
                        </TabItem>

                        <!-- 作業前後の設定を、このタブの中で見比べる -->
                        <TabItem Header="差分比較">
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                                   ToolTip="{x:Static help:TabHelp.AciDiff}" />
                                        <TextBlock Style="{StaticResource TabIntro}" Text="テナントの設定を作業の前と後で取って、その場で見比べます。" />
                                    </DockPanel>

                                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock Text="テナント" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="0,0,5,2" />
                                        <ComboBox Width="180" Margin="0,0,12,2"
                                                  ItemsSource="{Binding Tenants}"
                                                  SelectedItem="{Binding SelectedTenant}"
                                                  ToolTip="上の「取得」を押すと、ここにテナントが並びます。" />

                                        <Button Content="作業前を取得" Command="{Binding FetchBeforeCommand}"
                                                Margin="0,0,6,2"
                                                ToolTip="いまの設定を「作業前」として取ります（設定は書きません）。" />
                                        <Button Content="作業後を取得" Command="{Binding FetchAfterCommand}"
                                                Margin="0,0,6,2"
                                                ToolTip="作業を終えてから押します。同じテナントをもう一度取ります。" />

                                        <!-- 取ったものを証跡として残す（2026-08-18 ユーザー指示） -->
                                        <Button Content="作業前を保存" Command="{Binding SaveSideCommand}" CommandParameter="before"
                                                Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                                ToolTip="取った「作業前」の設定をテキストファイルに残します（事前ログ）。" />
                                        <Button Content="作業後を保存" Command="{Binding SaveSideCommand}" CommandParameter="after"
                                                Style="{StaticResource Button.Subtle}" Margin="0,0,12,2"
                                                ToolTip="取った「作業後」の設定をテキストファイルに残します（事後ログ）。" />

                                        <Button Content="比較" Command="{Binding CompareCommand}" Margin="0,0,6,2" />
                                        <Button Content="取得内容に戻る" Command="{Binding ShowFetchedCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="0,0,12,2"
                                                ToolTip="結果を閉じて、取ってきた設定そのものに戻ります。" />

                                        <Button Content="◀ 前の差分" Command="{Binding PreviousDifferenceCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="0,0,6,2" />
                                        <Button Content="次の差分 ▶" Command="{Binding NextDifferenceCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="0,0,6,2" />
                                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="0,0,12,2" />

                                        <CheckBox Content="異なる行だけ" IsChecked="{Binding OnlyDifferences}"
                                                  VerticalAlignment="Center" Margin="0,0,12,2" />
                                        <TextBlock Text="{Binding DiffHeadline}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" />
                                    </WrapPanel>

                                    <Grid>
                                        <!-- 取ってきたものそのもの。押した結果が空でないことを、その場で見せる -->
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowFetchedText}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="11" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                        </Grid.ColumnDefinitions>

                                        <Thumb Grid.Column="1" Style="{StaticResource PaneGrip.V}" DragStarted="OnPaneGrab" DragDelta="OnPaneDrag" />

                                            <DockPanel Grid.Column="0">
                                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}"
                                                           Margin="0,0,0,3" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding BeforeLabel}" />
                                                <Border DockPanel.Dock="Top" Height="1" Margin="0,0,0,2"
                                                        Background="{DynamicResource Brush.Border}" />
                                                <!-- 手で書き換えられる（2026-08-23 ユーザー指示）。「作業前を保存」で
                                                     残した控えを貼って今と比べられるように。ファイルの放り込みも受ける -->
                                                <TextBox x:Name="AciBeforeBox"
                                                         Text="{Binding BeforeText, UpdateSourceTrigger=PropertyChanged}"
                                                         FontFamily="{DynamicResource Font.Mono}"
                                                         FontSize="{DynamicResource Size.Caption}"
                                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                                         AllowDrop="True"
                                                         PreviewDragOver="OnTextDragOver" Drop="OnTextDrop"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         VerticalContentAlignment="Top" />
                                            </DockPanel>

                                            <!-- 作業前と作業後の区切り。左右の余白は差分比較タブと同じ 5px -->
                                            <Border Grid.Column="1" Width="1" Margin="5,0"
                                                    Background="{DynamicResource Brush.Border}" IsHitTestVisible="False" />

                                            <DockPanel Grid.Column="2">
                                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}"
                                                           Margin="0,0,0,3" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding AfterLabel}" />
                                                <Border DockPanel.Dock="Top" Height="1" Margin="0,0,0,2"
                                                        Background="{DynamicResource Brush.Border}" />
                                                <!-- こちらも手で書き換えられる（作業前の欄と同じ理由） -->
                                                <TextBox x:Name="AciAfterBox"
                                                         Text="{Binding AfterText, UpdateSourceTrigger=PropertyChanged}"
                                                         FontFamily="{DynamicResource Font.Mono}"
                                                         FontSize="{DynamicResource Size.Caption}"
                                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                                         AllowDrop="True"
                                                         PreviewDragOver="OnTextDragOver" Drop="OnTextDrop"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         VerticalContentAlignment="Top" />
                                            </DockPanel>
                                        </Grid>

                                        <!--
                                            比べた結果。左右は別々の一覧にして、それぞれで横スクロールする
                                            （長い行のため）。縦だけは code-behind で互いに合わせる
                                        -->
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowFetchedText}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="11" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                        </Grid.ColumnDefinitions>

                                        <Thumb Grid.Column="1" Style="{StaticResource PaneGrip.V}" DragStarted="OnPaneGrab" DragDelta="OnPaneDrag" />

                                            <DockPanel Grid.Column="0">
                                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}"
                                                           Margin="42,0,0,3" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding BeforeLabel}" />
                                                <Border DockPanel.Dock="Top" Height="1" Margin="0,0,0,2"
                                                        Background="{DynamicResource Brush.Border}" />
                                                <ListBox x:Name="AciDiffBefore"
                                                         Tag="{Binding ElementName=AciDiffAfter}"
                                                         ItemsSource="{Binding DiffRows}"
                                                         ItemContainerStyle="{StaticResource PlainCompactContainer}"
                                                         SelectedIndex="{Binding SelectedDiffIndex, Mode=TwoWay}"
                                                         Background="Transparent" BorderThickness="0"
                                                         HorizontalContentAlignment="Stretch"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                         ScrollViewer.ScrollChanged="OnDiffPaneScrolled"
                                                         VirtualizingStackPanel.IsVirtualizing="True"
                                                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                                    <ListBox.ItemTemplate>
                                                        <StaticResource ResourceKey="DiffRow.Left" />
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </DockPanel>

                                            <!-- 作業前と作業後の区切り。左右の余白は差分比較タブと同じ 5px -->
                                            <Border Grid.Column="1" Width="1" Margin="5,0"
                                                    Background="{DynamicResource Brush.Border}" IsHitTestVisible="False" />

                                            <DockPanel Grid.Column="2">
                                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}"
                                                           Margin="42,0,0,3" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding AfterLabel}" />
                                                <Border DockPanel.Dock="Top" Height="1" Margin="0,0,0,2"
                                                        Background="{DynamicResource Brush.Border}" />
                                                <ListBox x:Name="AciDiffAfter"
                                                         Tag="{Binding ElementName=AciDiffBefore}"
                                                         ItemsSource="{Binding DiffRows}"
                                                         ItemContainerStyle="{StaticResource PlainCompactContainer}"
                                                         SelectedIndex="{Binding SelectedDiffIndex, Mode=TwoWay}"
                                                         Background="Transparent" BorderThickness="0"
                                                         HorizontalContentAlignment="Stretch"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                         ScrollViewer.ScrollChanged="OnDiffPaneScrolled"
                                                         VirtualizingStackPanel.IsVirtualizing="True"
                                                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                                    <ListBox.ItemTemplate>
                                                        <StaticResource ResourceKey="DiffRow.Right" />
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </DockPanel>
                                        </Grid>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>


                    </TabControl>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- ===== ステータスバー ===== -->
    </Grid>
</Window>
