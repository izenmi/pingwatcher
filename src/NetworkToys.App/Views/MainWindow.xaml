<!-- 既定の大きさは「表がひととおり見える」ことを優先して広めに取る(2026-08-18 ユーザー指示)。
     以前はタブが一列に収まる最小(880x760)まで詰めていたが、列の多い表で右端が隠れていた。
     タブが一列に収まるかは自己診断が実測して確かめている。
     ここに書けるのは「広い画面での既定」だけなので、画面からはみ出す分は
     起動時に作業領域へ収める(MainWindow.FitToScreen)。
     狭めたい人は縮められるよう MinWidth / MinHeight は据え置き -->
<Window x:Class="NetworkToys.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NetworkToys.App.Controls"
        xmlns:vm="clr-namespace:NetworkToys.App.ViewModels"
        xmlns:mvvm="clr-namespace:NetworkToys.App.Mvvm"
        xmlns:help="clr-namespace:NetworkToys.App.Help"
        xmlns:net="clr-namespace:NetworkToys.Core.Net;assembly=NetworkToys.Core"
        Title="NetworkToys"
        Width="1180" Height="800"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Backdrop}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Size.Body}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 件数 0 のときだけ出す（空の一覧の案内用） -->
        <mvvm:ZeroToVisibleConverter x:Key="ZeroToVisible" />

        <!--
            一覧から次の道具へ送るメニュー。スキャン・接続・遮断・Meraki・syslog・Trap で
            使い回す。これまで橋が架かっていたのは Ping/TCP の一覧だけで、他のタブで
            見つけた IP は手で打ち直すしかなかった。

            x:Shared="False" を付けて、使う一覧ごとに別の実体を作らせる。
            1 つの実体を複数の要素で共有すると PlacementTarget が取り合いになる。

            アドレスの取り出しはコードビハインドの AddressOf に集約してあるので、
            ここは Click の名前を揃えるだけでよい。
        -->
        <ContextMenu x:Key="RowMenu.Device" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext,
                                   RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Ping の宛先に追加" Click="OnSendToPing" />
            <MenuItem Header="ログ採取の機器に追加" Click="OnSendToCollect" />
            <Separator />
            <MenuItem Header="Traceroute を実施" Click="OnSendToTrace" />
            <MenuItem Header="DNS 解決" Click="OnSendToDns" />
            <MenuItem Header="SNMP Get で問い合わせ" Click="OnSendToSnmp" />
            <Separator />
            <MenuItem Header="TCP Ping に追加" Click="OnSendToTcp" />
            <MenuItem Header="アドレスをコピー" Click="OnCopyRowAddress" />
            <MenuItem Header="行をコピー" Click="OnCopyRow" ToolTip="行の見えている値をタブ区切りでコピーします（Excel やチケットに貼れます）。" />
        </ContextMenu>

        <!-- 通信の相手（接続・遮断・Meraki のクライアント）。機器として扱う項目は出さない -->
        <ContextMenu x:Key="RowMenu.Address" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext,
                                   RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Ping の宛先に追加" Click="OnSendToPing" />
            <Separator />
            <MenuItem Header="Traceroute を実施" Click="OnSendToTrace" />
            <MenuItem Header="DNS 解決" Click="OnSendToDns" />
            <Separator />
            <MenuItem Header="アドレスをコピー" Click="OnCopyRowAddress" />
            <MenuItem Header="行をコピー" Click="OnCopyRow" ToolTip="行の見えている値をタブ区切りでコピーします（Excel やチケットに貼れます）。" />
        </ContextMenu>

        <!--
            各タブの先頭に置く 1 行の説明と、その左の ⓘ。
            「何をする画面か」は開いた瞬間に分かる必要がある（タブ名だけでは足りない）。
            詳しい話は ⓘ にマウスを載せたときだけ出し、常時は 1 行に抑える。
        -->
        <Style x:Key="TabIntro" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TabInfoMark" TargetType="TextBlock">
            <Setter Property="Text" Value="ⓘ" />
            <!-- 本文と同じ大きさだと、目印としても当たり判定としても小さい -->
            <Setter Property="FontSize" Value="{DynamicResource Size.Heading}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Fg}" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <!-- すぐ出して、読み終わるまで消えないようにする -->
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.ShowDuration" Value="120000" />
            <!-- クリックでも読める（ホバーで読み切れないとき用。2026-08-20 の UX 改善）。
                 EventSetter は IStyleConnector 経由の正規の結線で、「Setter の中の
                 イベントハンドラ付き要素」の罠（CLAUDE.md）の対象外。
                 ただし x:Class のある XAML（この MainWindow.xaml）でしか使えない -->
            <EventSetter Event="MouseLeftButtonDown" Handler="OnTabInfoClick" />
        </Style>

        <!--
            画面を左右/上下に割る比率の仕切り。透明で、指すと淡く浮く。
            比率は保存しない（列幅と同じ決まり）。星のトラックには必ず Min を入れること
            （xUnit が突き合わせる。潰れると戻す手掛かりが無くなる）。
        -->
        <!--
            GridSplitter は使わない。星サイズ＋Min の組で端までドラッグすると
            比率が跳ね戻る既知の癖がある（2026-08-20 に実機で報告された）。
            列幅ドラッグと同じ「Thumb ＋ 掴んでからの総移動量 ＋ 明示クランプ」で、
            Min にぴったり止まる動きを自前で持つ。
        -->
        <Style x:Key="PaneGrip.V" TargetType="Thumb">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Tag" Value="cols" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="Transparent" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PaneGrip.H" TargetType="Thumb" BasedOn="{StaticResource PaneGrip.V}">
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="Tag" Value="rows" />
        </Style>

        <!--
            切り詰められた長文のセル。クリックで全文を別窓（コピー可）に出す
            （2026-08-20 の UX 改善。ToolTip はコピーできず、すぐ消える）。
            TextTrimming でも Text プロパティは全文を持っているので、ハンドラは
            sender の Text を出すだけでよい。ToolTip は残す（ホバーでも読める）。
        -->
        <Style x:Key="ExpandableCell" TargetType="TextBlock">
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="MouseLeftButtonDown" Handler="OnExpandableCellClick" />
        </Style>
        <!-- Caption スタイルのセル用（スタイルは 1 つしか当てられないため BasedOn 版を持つ） -->
        <Style x:Key="ExpandableCell.Caption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="MouseLeftButtonDown" Handler="OnExpandableCellClick" />
        </Style>

        <!-- 値の表示欄。読み取り専用の TextBox にして、選択してコピーできるようにする -->
        <Style x:Key="CopyableValue" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <!--
            Ping 一覧の列幅。以前は列見出しと行テンプレートの両方に同じ数字を
            書いていて、片方だけ直すとずれた。幅の出どころをここ 1 か所にする。

            StaticResource なのは、実行中に変わらない値だから。DynamicResource に
            すると仮想化された行を作り直すたびに解決が走る。前方参照はできないので、
            使う側より前に置くこと。
        -->
        <!-- 一覧 1 行。列幅は上の定義を見出しと共有している -->
        <DataTemplate x:Key="TargetRowTemplate">
            <Grid Height="{DynamicResource Size.RowHeight}">
                <!-- 幅はヘッダと共有(ColumnLayout)。ヘッダの境目をドラッグすると全行が追随する。
                     備考は宛先の右隣(ユーザー指示)の可変幅で、余った幅を吸収する。 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=State}" MinWidth="36" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Target}" MinWidth="60" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Rtt}" MinWidth="36" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Loss}" MinWidth="36" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Spark}" MinWidth="60" />
                </Grid.ColumnDefinitions>

                <Border x:Name="Badge"
                        Grid.Column="0"
                        Style="{StaticResource Badge}"
                        Background="{DynamicResource Brush.Info.Bg}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="BadgeText"
                               Style="{StaticResource Badge.Text}"
                               Foreground="{DynamicResource Brush.Info.Fg}"
                               Text="◌ 待機" />
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding HostDisplay}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding HostDisplay}" />

                <TextBlock Grid.Column="2" Text="{Binding Comment}"
                           Style="{StaticResource Caption}"
                           Margin="8,0,8,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Comment}" />

                <TextBlock Grid.Column="3" Text="{Binding LatestRtt}"
                           Style="{StaticResource Mono}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />

                <TextBlock Grid.Column="4" Text="{Binding Loss}"
                           Style="{StaticResource Mono}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />

                <controls:Sparkline Grid.Column="5" Source="{Binding}" Margin="8,3,8,3"
                                    LineBrush="{DynamicResource Brush.Chart.Line}"
                                    LostBrush="{DynamicResource Brush.Error.Fg}" />

                <!-- 列の区切り線。行の区切り線と同じ淡さの縦線で、境目を目で追えるようにする -->
                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Ok">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Ok.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="● 応答" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Down">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Error.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="✕ 不通" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Refused">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Warn.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="⊘ 拒否" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unresolved">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Error.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="? 名前" />
                </DataTrigger>
                <!-- 測定が止まっている状態。不達と取り違えると確認ツールとして嘘になる -->
                <DataTrigger Binding="{Binding State}" Value="Stalled">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="… 停止" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            右クリックメニューを持たない行コンテナ。
            スキャン結果・周辺 AP・作業比較・差分比較の一覧はこちらを使う。
            メニュー付きのコンテナを流用すると、DataContext の型が違うため
            「経路を調べる」などを押しても無反応のメニューが出てしまう。
        -->
        <Style x:Key="PlainRowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- 下辺だけ淡い線を引き、詰めた行の境目を示す(選択枠の透明ボーダーは持たない) -->
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Brush.Row.Line}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            </Trigger>
                            <!-- キーボードで動かしたときの現在地（2026-08-20 の UX 改善）。
                                 太さは変えない — 変えると行の高さが揺れて仮想化中にガタつく -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 上の枠付き版。差分比較の一覧が使う（選択を枠で示す） -->
        <!--
            差分の 1 行（片側ぶん）。左右で色の語彙が違うだけ（消えた側は Error.Bg）。
            差分比較タブと ACI の差分比較サブタブで使い回す。
        -->
        <DataTemplate x:Key="DiffRow.Left">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding LeftNumberText}"
                           Style="{StaticResource Mono}"
                           FontSize="{DynamicResource Size.Caption}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           HorizontalAlignment="Right" Margin="0,0,10,0" />

                <!-- 行の中の違う箇所だけ地色を変える(WinMerge の行内色分け) -->
                <Border x:Name="Cell" Grid.Column="1" Padding="4,0"
                        CornerRadius="{DynamicResource Radius.Chip}" Margin="0,0,6,0">
                    <controls:DiffText Segments="{Binding LeftSegments}"
                                       ChangedBrush="{DynamicResource Brush.Error.Bg}"
                                       Style="{StaticResource Mono}"
                                       FontSize="{DynamicResource Size.Caption}"
                                       TextWrapping="NoWrap" />
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Changed">
                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Brush.Warn.Bg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="LeftOnly">
                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Brush.Error.Bg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            差分の 1 行（片側ぶん）。左右で色の語彙が違うだけ（増えた側は Ok.Bg）。
            差分比較タブと ACI の差分比較サブタブで使い回す。
        -->
        <DataTemplate x:Key="DiffRow.Right">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding RightNumberText}"
                           Style="{StaticResource Mono}"
                           FontSize="{DynamicResource Size.Caption}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           HorizontalAlignment="Right" Margin="0,0,10,0" />

                <!-- 行の中の違う箇所だけ地色を変える(WinMerge の行内色分け) -->
                <Border x:Name="Cell" Grid.Column="1" Padding="4,0"
                        CornerRadius="{DynamicResource Radius.Chip}" Margin="0,0,6,0">
                    <controls:DiffText Segments="{Binding RightSegments}"
                                       ChangedBrush="{DynamicResource Brush.Ok.Bg}"
                                       Style="{StaticResource Mono}"
                                       FontSize="{DynamicResource Size.Caption}"
                                       TextWrapping="NoWrap" />
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Changed">
                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Brush.Warn.Bg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="RightOnly">
                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Brush.Ok.Bg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            差分の行の入れ物。<b>余白を足さない</b> — 貼り付け欄（素の TextBox）と
            同じ行間で読めるようにするため（2026-08-17 ユーザー指示で詰めた）。
            選択の枠は 1px だけ持つ。行の地色は差分の色に使っているので、
            選択を地色で示すと色がぶつかる。
        -->
        <Style x:Key="PlainCompactContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Sel"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Margin="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sel" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Bg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Sel" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            </Trigger>
                            <!-- キーボードで動かしたときの現在地（2026-08-20 の UX 改善）。
                                 太さは変えない — 変えると行の高さが揺れて仮想化中にガタつく -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Sel" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行コンテナ。選択の見た目だけ差し替え、既定の青い選択色は使わない -->
        <Style x:Key="TargetRowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- 下辺だけ淡い線を引き、詰めた行の境目を示す(選択枠の透明ボーダーは持たない) -->
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Brush.Row.Line}"
                                Padding="{TemplateBinding Padding}">
                            <!--
                                右クリックの行き先。イベントの結線はテンプレートの中でしか当てにできない。
                                Style の Setter へ直接 ContextMenu を置くと、リソースが後から
                                展開される都合で結線がずれ、起動時に落ちる（自己診断で実証済み）。

                                メニューは論理ツリーが切れているので、PlacementTarget 経由で
                                右クリックした行そのものを DataContext にする。
                                選択は動かさない（左クリックの挙動は今まで通り）。
                            -->
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                           RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="SSH で接続" Click="OnSshFromRow" />
                                    <MenuItem Header="Telnet で接続" Click="OnTelnetFromRow" />
                                    <MenuItem Header="ログ採取の機器に追加" Click="OnCollectFromRow" />
                                    <Separator />
                                    <MenuItem Header="Traceroute を実施" Click="OnTraceFromRow" />
                                    <MenuItem Header="DNS 解決" Click="OnResolveFromRow" />
                                    <Separator />
                                    <MenuItem Header="TCP Ping に追加" Click="OnAddToTcpFromRow" />
                                    <MenuItem Header="アドレスをコピー" Click="OnCopyAddressFromRow" />
                                    <MenuItem Header="行をコピー" Click="OnCopyRow" ToolTip="行の見えている値をタブ区切りでコピーします（Excel やチケットに貼れます）。" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                            </Trigger>
                            <!-- キーボードで動かしたときの現在地（2026-08-20 の UX 改善）。
                                 太さは変えない — 変えると行の高さが揺れて仮想化中にガタつく -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            応答なし欄用の行コンテナ。選択はアクセントの緑ではなく赤系で示す。
            赤いカードの中で選択行だけ緑に光ると、状態が変わったように見えてしまう。
        -->
        <Style x:Key="DownRowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- 下辺だけ淡い線を引き、詰めた行の境目を示す(選択枠の透明ボーダーは持たない) -->
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Brush.Row.Line}"
                                Padding="{TemplateBinding Padding}">
                            <!--
                                右クリックの行き先。イベントの結線はテンプレートの中でしか当てにできない。
                                Style の Setter へ直接 ContextMenu を置くと、リソースが後から
                                展開される都合で結線がずれ、起動時に落ちる（自己診断で実証済み）。

                                メニューは論理ツリーが切れているので、PlacementTarget 経由で
                                右クリックした行そのものを DataContext にする。
                                選択は動かさない（左クリックの挙動は今まで通り）。
                            -->
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                           RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="SSH で接続" Click="OnSshFromRow" />
                                    <MenuItem Header="Telnet で接続" Click="OnTelnetFromRow" />
                                    <MenuItem Header="ログ採取の機器に追加" Click="OnCollectFromRow" />
                                    <Separator />
                                    <MenuItem Header="Traceroute を実施" Click="OnTraceFromRow" />
                                    <MenuItem Header="DNS 解決" Click="OnResolveFromRow" />
                                    <Separator />
                                    <MenuItem Header="TCP Ping に追加" Click="OnAddToTcpFromRow" />
                                    <MenuItem Header="アドレスをコピー" Click="OnCopyAddressFromRow" />
                                    <MenuItem Header="行をコピー" Click="OnCopyRow" ToolTip="行の見えている値をタブ区切りでコピーします（Excel やチケットに貼れます）。" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <!-- 面を一段持ち上げて示す(緑のアクセントは使わない) -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <!-- キーボードで動かしたときの現在地（2026-08-20 の UX 改善）。
                                 太さは変えない — 変えると行の高さが揺れて仮想化中にガタつく -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Error.Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            1 行 1 件の一覧（仮想化必須）。
            参照するテンプレートより後に置くこと（StaticResource は前方参照できない）。
        -->
        <!--
            機器を選ぶ札。タブと同じ見た目にして「押して切り替えるもの」と分かるようにする。
            選択中はアクセント色で塗り、貼り付け済みの数を添える。
        -->
        <Style x:Key="DeviceChip" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Cursor" Value="Hand" />
            <!-- 寸法はメインタブ(Padding 6,2・Size.Caption・間隔 2)と揃える -->
            <Setter Property="FontSize" Value="{DynamicResource Size.Caption}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Padding="6,2"
                                Margin="0,0,2,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Bg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Fg}" />
                                <Setter Property="FontWeight" Value="Normal" />
                            </Trigger>
                            <!-- キーボードで動かしたときの現在地（2026-08-20 の UX 改善）。
                                 太さは変えない — 変えると行の高さが揺れて仮想化中にガタつく -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TargetListBox" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <!--
                縦スクロールバーは常に場所を取る。出た瞬間に行だけ 14px 狭くなると、
                可変幅(備考)より右の列が見出しとずれる（ほかの 16 表と同じ決まり）。
                見出し側は右の余白でこの 14px を先に空けてある（11 + 14 = 25）。
            -->
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            <!--
                仮想化の指定は ListBox 側に付ける。VirtualizingStackPanel は自分の
                属性ではなく ItemsControl 側の添付プロパティを読むため、パネル要素に
                書いた VirtualizationMode は参照されず、Recycling が効かないまま
                コンテナが使い捨てで生成され続ける。
            -->
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemTemplate" Value="{StaticResource TargetRowTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TargetRowContainer}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="6,5,6,4">
        <!-- メニューの帯と本体の 2 段だけ。ヘッダも接続情報のフッターも廃止した
             (本体を広く取るため。接続情報は IP設定タブの現在値で見られる) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            ===== メニューバー =====
            トップレベルは MenuBarItem スタイル(自前の PART_Popup 持ち)。
            中の項目は暗黙 MenuItem スタイル(葉項目専用・サブメニュー不可)なので
            すべてフラットに並べる。Style の Setter ではなく要素へ直接置いているので
            Click の結線はずれない(CLAUDE.md 参照)。
        -->
        <Menu x:Name="MainMenu" Grid.Row="0" Margin="0,0,0,7" Background="Transparent">
            <!-- 開く直前に「保存できるか」を聞き直す。記録の画面を畳んだので、
                 ここを逃すと起動直後の判定のまま押せなくなる -->
            <MenuItem Header="ファイル(_F)" Style="{StaticResource MenuBarItem}"
                      SubmenuOpened="OnFileMenuOpened">
                <MenuItem Header="レポートを HTML で保存(_H)..." Command="{Binding Report.SaveHtmlCommand}" />
                <MenuItem Header="レポートをテキストで保存(_T)..." Command="{Binding Report.SaveTextCommand}" />
                <MenuItem Header="レポートを CSV で保存(_C)..." Command="{Binding Report.SaveCsvCommand}" />
                <Separator />
                <MenuItem Header="画面を撮って保存(_S)" InputGestureText="F12" Click="OnScreenshot" />
                <MenuItem Header="データフォルダを開く(_D)" Click="OnOpenDataFolder" />
                <Separator />
                <MenuItem Header="管理者として再起動(_R)..." Click="OnRelaunchAsAdmin" />
                <Separator />
                <!-- 消す操作もここに置く（2026-08-16 ユーザー指示で「測定」メニューを畳んだ）。
                     開始と停止は Ping タブの中だけ。F5 / Shift+F5 は InputBindings 側に残る -->
                <MenuItem Header="Ping の測定結果だけ消す(_P)" Click="OnClearPingResults" />
                <!-- 重さがまるで違う 2 つを隣接させない（押し間違い対策。2026-08-20） -->
                <Separator />
                <MenuItem Header="すべて消す（起動直後に戻す）(_A)" Click="OnClearAll" />
                <Separator />
                <MenuItem Header="終了(_X)" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="表示(_V)" Style="{StaticResource MenuBarItem}">
                <MenuItem x:Name="ThemeMenuItem" Click="OnThemeToggle" />
                <MenuItem x:Name="TopmostMenuItem" Header="最前面に固定(_P)" IsCheckable="True"
                          Click="OnTopmostMenu" />
                <Separator />
                <!-- 文字の大きさ。サブメニューは作れない作りなので並べる。
                     Tag が倍率で、選ばれているものにチェックが付く -->
                <MenuItem x:Name="ScaleSmall" Header="文字サイズ 小(_1)" IsCheckable="True"
                          Tag="0.85" Click="OnScaleMenu" />
                <MenuItem x:Name="ScaleNormal" Header="文字サイズ 標準(_2)" IsCheckable="True"
                          Tag="1.0" Click="OnScaleMenu" />
                <MenuItem x:Name="ScaleLarge" Header="文字サイズ 大(_3)" IsCheckable="True"
                          Tag="1.25" Click="OnScaleMenu" />
                <MenuItem x:Name="ScaleExtraLarge" Header="文字サイズ 特大(_4)" IsCheckable="True"
                          Tag="1.5" Click="OnScaleMenu" />
                <Separator />
                <!-- 列幅はドラッグで変えられる（保存はしないが、その場で戻したいとき用） -->
                <MenuItem Header="列幅を既定に戻す(_R)" Click="OnResetColumns" />
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)" Style="{StaticResource MenuBarItem}">
                <MenuItem Header="使い方(_U)" Click="OnShowUsage" />
                <Separator />
                <MenuItem Header="ライセンス情報(_L)" Click="OnShowLicenses" />
                <MenuItem Header="バージョン情報(_A)" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <!--
            知らせの置き場。メニューの帯の右端に間借りする（2026-08-16 ユーザー指示で
            ヘッダ 1 行を丸ごと廃止した。表題もダークモードのボタンも要らないと判断）。
            伝えないと困ること（測定の失敗・保存の結果）だけをここに出す。
        -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
            <!-- Ping の進行状態はタブの中に出す（帯の常駐表示は 2026-08-20 ユーザー指示で削除。
                 「宛先を書いて〜」の案内が常に居座って煩かった） -->

            <TextBlock Text="{Binding Report.Status}" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" MaxWidth="320"
                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

            <!-- 操作の結果を短く知らせる場所(画面保存・ファイルの読み込みなど)。数秒で消える -->
            <TextBlock x:Name="HeaderNotice" MouseLeftButtonDown="OnNoticeClick" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />

            <!-- 配色の切り替え。メニューにもあるが、押す頻度が高いので右上にも置く
                 (2026-08-16 ユーザー指示)。記号だけでは意味が伝わらないので文字も添える -->
            <Button x:Name="ThemeToggle" Click="OnThemeToggle"
                    Style="{StaticResource Button.Icon}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="配色の切り替え"
                    ToolTip="ライトモードとダークモードを切り替えます。次回起動にも残ります。" />
        </StackPanel>

        <!-- メニューの帯と本体を分ける罫線。行の下端に置き、上下に余白を取る
             （上はメニューの Margin、下はタブ側の Margin で作る） -->
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                Background="{DynamicResource Brush.Border}" />

        <!-- ===== 本体 ===== -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,5,0,0" SelectionChanged="OnTabSelectionChanged"
                    PreviewMouseLeftButtonDown="OnMainTabsMouseDown">

            <!-- ===== Ping（測定と結果の表示） ===== -->
            <TabItem x:Name="PingTab" Header="Ping" DataContext="{Binding Monitor}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="{x:Static help:TabHelp.Ping}" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="相手に ping を打ち続けて、つながっているかを見張ります。" />
                        </DockPanel>


                        <!-- 操作列。開始・停止はこの画面に置く（2026-08-16 ユーザー指示で
                             ヘッダから移した）。F5 / Shift+F5 とメニューからも打てる -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                            <Button Content="{Binding RunButtonLabel}" Command="{Binding StartCommand}"
                                    Click="OnStartClicked" Margin="0,0,5,0" />
                            <Button Content="停止" Command="{Binding StopCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,12,0" />

                            <!-- 宛先リストの編集。別タブに分けていたが、測りながら書き換える
                                 使い方が多いのでこの画面に畳んだ（2026-08-16 ユーザー指示） -->
                            <ToggleButton x:Name="TargetListToggle" Content="宛先リスト ▾"
                                          Checked="OnTargetListToggle" Unchecked="OnTargetListToggle"
                                          Style="{StaticResource ToggleButton.Subtle}"
                                          Margin="0,0,12,0"
                                          ToolTip="測りたい相手をまとめて書く欄を開きます。書き換えると自動で反映され、測定は止まりません。" />

                            <Button Content="履歴を消去"
                                    Command="{Binding ClearHistoryCommand}"
                                    Style="{StaticResource Button.Subtle}"
                                    Margin="0,0,12,0" />
                            <TextBlock Text="絞り込み" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="180" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}" Margin="0,0,12,0"
                                     ToolTip="宛先・備考・解決したアドレスの部分一致で絞り込みます。測定は続きます。" />
                            <!-- 進行状態。TCP タブと同じ位置に出す（メニュー帯右端だけでは
                                 見落とす。2026-08-20 の UI 改善） -->
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Margin="0,0,12,0" />
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="330"
                                       Text="行を右クリックすると、SSH/Telnet 接続や経路調査ができます。" />
                        </StackPanel>

                        <!--
                            宛先リスト。既定は畳んである（測定結果の場所を奪わないため）。
                            書式は EXPing に合わせてあり、書き換えると自動で反映される。
                            ファイルを放り込んでも読み込める。
                        -->
                        <!-- 宛先リストと結果は仕切りで割合を変えられる(2026-08-21 ユーザー指示)。
                             編集欄は開閉式なので、閉じたら行ごと畳む(OnTargetListToggle。
                             星のままだと空の行が場所を取り続ける) -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="PingEditorRow" Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="120" />
                            </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource Brush.Surface}"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="7,6"
                                Visibility="{Binding IsChecked, ElementName=TargetListToggle,
                                             Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,0,0,4">
                                    1 行 1 宛先。アドレスの後ろに半角スペースを空けると備考です。行頭が
                                    <Run>#</Run> <Run>;</Run> <Run>'</Run> 全角スペース の行は注釈。
                                    範囲でも書けます:
                                    <Run FontFamily="{DynamicResource Font.Mono}">192.168.1.10-20</Run> ／
                                    <Run FontFamily="{DynamicResource Font.Mono}">192.168.1.0/24</Run>
                                </TextBlock>

                                <!-- 名前を付けて残したリスト。現場ごとに測る相手は決まっているので
                                     いくつか持って切り替えられるようにする（2026-08-17 ユーザー指示） -->
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <TextBlock Text="保存したリスト" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="0,0,5,2" />
                                    <ComboBox Width="180" Margin="0,0,6,2"
                                              ItemsSource="{Binding SavedLists}"
                                              SelectedItem="{Binding SelectedListName}"
                                              ToolTip="選ぶと、その宛先リストに入れ替わります。いま出ているものは元の名前へ残します。" />
                                    <Button Content="名前を付けて残す" Command="{Binding SaveListCommand}"
                                            Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                            ToolTip="いまの宛先に名前を付けて残します。同じ名前なら上書きします。" />
                                    <Button Content="消す" Command="{Binding DeleteListCommand}"
                                            Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                            ToolTip="選んでいるリストを消します（確認が出ます）。いま出ている宛先はそのまま残ります。" />
                                </WrapPanel>

                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ListSummary}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Margin="0,4,0,0" />

                                <TextBox Text="{Binding TargetListText, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{DynamicResource Font.Mono}"
                                         FontSize="{DynamicResource Size.Caption}"
                                         AcceptsReturn="True"
                                         AcceptsTab="False"
                                         TextWrapping="NoWrap"
                                         MinHeight="120"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         AllowDrop="True" Tag="drop:targets"
                                         PreviewDragOver="OnTextDragOver" Drop="OnTextDrop"
                                         ToolTip="宛先を書いたテキストファイルを、この欄に放り込んでも読み込めます。" />
                            </DockPanel>
                        </Border>

                        <Thumb Grid.Row="1" Height="11" Style="{StaticResource PaneGrip.H}"
                               DragStarted="OnPaneGrab" DragDelta="OnPaneDrag"
                               Visibility="{Binding IsChecked, ElementName=TargetListToggle,
                                            Converter={StaticResource BoolToVisibility}}" />

                        <DockPanel Grid.Row="2">

                        <!-- 選択行の詳細。一覧に列を増やさずに済ませるための置き場 -->
                        <Border DockPanel.Dock="Bottom"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Control}" Padding="8,5" Margin="0,6,0,0">
                            <TextBlock Text="{Binding DetailText}"
                                       Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- 一覧のヘッダ。両方の欄で共通なので、分割の外に出して常に最上部へ置く。
                             列幅は TargetRowTemplate と合わせること -->
                        <StackPanel DockPanel.Dock="Top">
                            <!-- 左 11px は「カード枠 1 + カード余白 6 + 行余白 4」。
                                 右はそこに縦スクロールバーの 14px を足した 25px
                                 （一覧は常にバーの場所を取るので、行の右端は常に 14px 内側にある）。
                                 行側の仕切り線とヘッダの仕切り線がぴったり重なる値なので変えないこと -->
                            <Grid Margin="11,0,25,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=State, Mode=TwoWay}" MinWidth="36" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Target, Mode=TwoWay}" MinWidth="60" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Rtt, Mode=TwoWay}" MinWidth="36" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Loss, Mode=TwoWay}" MinWidth="36" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Spark, Mode=TwoWay}" MinWidth="60" />
                                </Grid.ColumnDefinitions>

                                <!-- クリックでソート(同じ列を再クリックで昇順→降順→元の並び)。
                                     文字だけだと当たり判定が狭いので、透明の Border で列幅いっぱいに受ける -->
                                <Border Grid.Column="0" Background="Transparent" Cursor="Hand" Tag="State"
                                        MouseLeftButtonDown="OnListHeaderSort"
                                        ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                    <TextBlock Text="{Binding HeaderState}" Style="{StaticResource Caption}" />
                                </Border>
                                <Border Grid.Column="1" Background="Transparent" Cursor="Hand" Tag="Target"
                                        MouseLeftButtonDown="OnListHeaderSort"
                                        ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                    <TextBlock Text="{Binding HeaderTarget}" Style="{StaticResource Caption}" />
                                </Border>
                                <Border Grid.Column="2" Background="Transparent" Cursor="Hand" Tag="Comment"
                                        MouseLeftButtonDown="OnListHeaderSort"
                                        ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                    <TextBlock Text="{Binding HeaderNote}" Style="{StaticResource Caption}" />
                                </Border>
                                <Border Grid.Column="3" Background="Transparent" Cursor="Hand" Tag="Rtt"
                                        MouseLeftButtonDown="OnListHeaderSort"
                                        ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                    <TextBlock Text="{Binding HeaderRtt}" Style="{StaticResource Caption}" />
                                </Border>
                                <Border Grid.Column="4" Background="Transparent" Cursor="Hand" Tag="Loss"
                                        MouseLeftButtonDown="OnListHeaderSort"
                                        ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                    <TextBlock Text="{Binding HeaderLoss}" Style="{StaticResource Caption}" />
                                </Border>
                                <TextBlock Grid.Column="5" Text="推移" Style="{StaticResource Caption}" />

                                <!-- 列の区切り線(行側と同じ色)。スプリッタの位置の目印にもなる -->
                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />

                                <!--
                                    列幅の変更。つまみは列ではなく<b>境目</b>を表し、
                                    掴んだ境目の左右の列だけが伸縮する(2026-08-18 ユーザー指示)。
                                    離れた列は幅も位置も変わらない。GridSplitter は使わない —
                                    幅の持ち主が ColumnLayout で、見出しと行の 2 つの Grid が
                                    同じ値を見る作りだから。Thumb の DragStarted/DragDelta で
                                    ColumnLayout に総移動量を渡す。
                                -->
                                <Thumb Grid.Column="0" Width="7" HorizontalAlignment="Right" Cursor="SizeWE"
                                       Tag="State" DragStarted="OnColumnGrab" DragDelta="OnColumnResize" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Thumb Grid.Column="1" Width="7" HorizontalAlignment="Right" Cursor="SizeWE"
                                       Tag="Target" DragStarted="OnColumnGrab" DragDelta="OnColumnResize" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <!-- 備考(星列)より右の列は、左端の境界につまみを置く。
                                     境目の左右で幅をやり取りするので、境目はカーソルに 1:1 で追従する -->
                                <Thumb Grid.Column="3" Width="7" HorizontalAlignment="Left" Cursor="SizeWE"
                                       Tag="Rtt" DragStarted="OnColumnGrab" DragDelta="OnColumnResize" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Thumb Grid.Column="4" Width="7" HorizontalAlignment="Left" Cursor="SizeWE"
                                       Tag="Loss" DragStarted="OnColumnGrab" DragDelta="OnColumnResize" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Thumb Grid.Column="5" Width="7" HorizontalAlignment="Left" Cursor="SizeWE"
                                       Tag="Spark" DragStarted="OnColumnGrab" DragDelta="OnColumnResize" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,4" />
                        </StackPanel>

                        <!--
                            2 回続けて応答が無かった宛先を上、応答のある宛先を下に置く。
                            手当てが要るのは落ちている方なので、そちらを目の高さに持ってくる。
                        -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="80" />
                            </Grid.RowDefinitions>

                            <!-- ===== 応答なし（2 回連続で失敗） ===== -->
                            <Border Grid.Row="0" Margin="0,0,0,7"
                                    Background="{DynamicResource Brush.Error.Bg}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Error.Fg}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDownRows}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <DockPanel MaxHeight="188">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                                Margin="1,0,0,4">
                                        <Border Width="3" CornerRadius="0" Margin="0,1,6,1"
                                                Background="{DynamicResource Brush.Error.Fg}" />
                                        <TextBlock Text="{Binding DownHeader}"
                                                   Foreground="{DynamicResource Brush.Error.Fg}"

                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding DownRows}"
                                             SelectedItem="{Binding SelectedDownRow}"
                                             ItemContainerStyle="{StaticResource DownRowContainer}"
                                             Style="{StaticResource TargetListBox}" />
                                </DockPanel>
                            </Border>

                            <!-- ===== 応答あり =====
                                 応答なしの赤いカードと対になるよう、こちらも枠のある
                                 カードにする。枠が無いと 2 つの欄の境目が読み取れない。
                                 帯に地色は敷かない(暗い配色では地の緑が沈んで濁るため)。 -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                                Margin="1,0,0,4">
                                        <Border Width="3" CornerRadius="0" Margin="0,1,6,1"
                                                Background="{DynamicResource Brush.Ok.Fg}" />
                                        <TextBlock Text="{Binding AliveHeader}"
                                                   Foreground="{DynamicResource Brush.Ok.Fg}"

                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- 仮想化を効かせるため行高は固定にしている -->
                                    <ListBox ItemsSource="{Binding AliveRows}"
                                             SelectedItem="{Binding SelectedAliveRow}"
                                             Style="{StaticResource TargetListBox}" />
                                </DockPanel>
                            </Border>
                        </Grid>
                        </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 遮断（WFP が落とした通信。読み取りにも管理者権限が要る） ===== -->
            <TabItem x:Name="WfpTab" Header="WFP" DataContext="{Binding Wfp}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="{x:Static help:TabHelp.Wfp}" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="Windows が遮断した通信を一覧にします。" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="一時停止" IsChecked="{Binding IsPaused}"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      ToolTip="更新を止めて、じっくり読んだり選択したりできます。" />
                            <TextBlock Text="絞り込み" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="200" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}" Margin="0,0,10,0"
                                     ToolTip="プロセス名・パス・アドレス・プロトコルの部分一致で絞り込みます。" />
                            <Button Content="更新" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                            <Button Content="CSV で保存" Command="{Binding SaveCommand}"
                                    Style="{StaticResource Button.Subtle}" />
                        </StackPanel>

                        <!-- 案内は 2 段構え: 文言の有無で畳み、ボタンはそれぞれの条件で出す -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6"
                                   Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                            <!-- この画面は管理者権限が要る。案内より先に目に入るよう左端に置き、
                                 注意の配色（警告色）で他のボタンと区別する（2026-08-18 ユーザー指示） -->
                            <Button DockPanel.Dock="Left" Content="管理者として再起動" Click="OnRelaunchAsAdmin"
                                    Background="{DynamicResource Brush.Warn.Bg}"
                                    Foreground="{DynamicResource Brush.Warn.Fg}"
                                    FontWeight="Bold" Padding="12,4"
                                    Margin="0,0,10,0" VerticalAlignment="Center"
                                    Visibility="{Binding CanRelaunchAsAdmin, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="いったん終了して、管理者権限で起動し直します。測定中の結果は失われます。" />
                            <Button DockPanel.Dock="Right" Content="記録を有効にする" Click="OnEnableWfpCollection"
                                    Style="{StaticResource Button.Subtle}" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding CanEnableCollection, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Windows にネットワークイベントの記録を始めさせます。アプリを閉じると元に戻します。" />
                            <TextBlock Text="{Binding Notice}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Warn.Fg}" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="4,0,18,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.0]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.1]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.2]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.3]}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.5]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.6]}" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="5" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="0" Background="Transparent" Cursor="Hand" Tag=""
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <TextBlock Text="{Binding TimeHeader}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="1" Background="Transparent" Cursor="Hand" Tag="Direction"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <TextBlock Text="{Binding DirectionHeader}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="2" Background="Transparent" Cursor="Hand" Tag="Protocol"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <TextBlock Text="{Binding ProtocolHeader}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="3" Background="Transparent" Cursor="Hand" Tag="Local"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <TextBlock Text="{Binding LocalHeader}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="4" Background="Transparent" Cursor="Hand" Tag="Remote"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <TextBlock Text="{Binding RemoteHeader}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="5" Background="Transparent" Cursor="Hand" Tag="Process"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <TextBlock Text="{Binding ProcessHeader}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="6" Background="Transparent" Cursor="Hand" Tag="Count"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <TextBlock Text="{Binding CountHeader}" Style="{StaticResource Caption}" />
                                    </Border>

                                    <!-- 列幅のつまみ。星列(3・4)より左は右端、右は左端の境界に置く -->
                                    <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="wfp.0" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="wfp.1" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="wfp.2" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="wfp.3" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="5" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                           Tag="wfp.5" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="6" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                           Tag="wfp.6" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                </Grid>
                                <Border DockPanel.Dock="Top" Height="1"
                                        Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />

                                <Grid>
                                <ListBox x:Name="WfpList" ItemsSource="{Binding Rows}"
                                         Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ItemContainerStyle="{StaticResource PlainRowContainer}"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible">
                                    <!-- 行の詰め方は接続タブと同じ。既定の ListBoxItem は
                                         余白を持つので、指定しないと 1 行ぶん背が高くなる -->
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 説明はプロセス欄に付ける。行全体に付けるとパスが空のとき空の枠が出る -->
                                            <Grid Height="{DynamicResource Size.RowHeight}"
                                                  ContextMenu="{StaticResource RowMenu.Address}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.0]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.1]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.2]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.3]}" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.5]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.6]}" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="5" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="DirectionText" Grid.Column="1" Text="{Binding DirectionText}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Protocol}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Local}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" Text="{Binding Remote}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="5" Text="{Binding ProcessName}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ProcessNote}" />
                                                <TextBlock Grid.Column="6" Text="{Binding CountText}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" Margin="0,0,10,0" />
                                            </Grid>

                                            <!--
                                                送信と受信で色を変える。既存のパレットから選んでいるので
                                                新しい色は足していない(明暗どちらの配色でもコントラストは検算済み)。
                                                色だけに頼らないよう、文字は「→ 送信」「← 受信」のまま残す。
                                                向きが読めなかった行は色を付けない(生の値を出したまま)。
                                            -->
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOutbound}" Value="True">
                                                    <Setter TargetName="DirectionText" Property="Foreground"
                                                            Value="{DynamicResource Brush.Info.Fg}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsInbound}" Value="True">
                                                    <Setter TargetName="DirectionText" Property="Foreground"
                                                            Value="{DynamicResource Brush.Warn.Fg}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                    <TextBlock Style="{StaticResource EmptyHint}"
                                               Text="「一時停止」を外すと、Windows が落とした通信がここに出ます"
                                               Visibility="{Binding Items.Count, ElementName=WfpList, Converter={StaticResource ZeroToVisible}}" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 差分比較（show ip route / show run を作業前後で見比べる） ===== -->
            <TabItem x:Name="CompareTab" Header="差分比較" DataContext="{Binding DeviceCompare}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="{x:Static help:TabHelp.Diff}" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="機器の設定を、作業の前と後で見比べます。" />
                        </DockPanel>


                        <!-- 操作 -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">

                            <!--
                                機器の並び。1 回の作業で何台も設定変更することがあるので、
                                台数ぶん並べて作業前をまとめて集められるようにしている。
                            -->
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="削除"
                                        Command="{Binding RemoveDeviceCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="4,0,0,0"
                                        ToolTip="選んでいる機器を、貼り付けごと削除します。" />
                                <Button DockPanel.Dock="Right" Content="＋ 機器"
                                        Command="{Binding AddDeviceCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="8,0,0,0"
                                        ToolTip="比較する機器を増やします。" />
                                <TextBox DockPanel.Dock="Right" Width="150"
                                         Text="{Binding SelectedDevice.Name, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="6,0,0,0" VerticalAlignment="Center"
                                         ToolTip="機器名。ホスト名を入れておくと記録を見返すときに分かります。" />
                                <TextBlock DockPanel.Dock="Right" Text="名前" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />

                                <ListBox ItemsSource="{Binding Devices}"
                                         SelectedItem="{Binding SelectedDevice}"
                                         ItemContainerStyle="{StaticResource DeviceChip}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- 起動幅(740px)では 1 行に収まらないので折り返す -->
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="対象" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <!--
                                    DisplayMemberPath は使わない。閉じているときの表示は
                                    SelectionBoxItemTemplate 経由で描かれるため、テンプレートを
                                    明示しないと選択中の項目が型名のまま出てしまう。
                                -->
                                <ComboBox Width="230" ItemsSource="{Binding Modes}"
                                          SelectedItem="{Binding SelectedMode}" Margin="0,0,10,0"
                                          ToolTip="対象ごとに貼り付けた内容は保たれます。作業前にまとめて貼っておけます。">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text="{Binding StateMark, Mode=OneWay}"
                                                     Foreground="{DynamicResource Brush.Info.Fg}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="比較" Command="{Binding CompareCommand}" Margin="0,0,6,2" />
                                <Button Content="貼り付けに戻る" Command="{Binding EditCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                        ToolTip="結果を閉じて貼り付け欄に戻ります。貼り付けた内容は残ります。" />
                                <Button Content="CSV で保存" Command="{Binding SaveChangesCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                        ToolTip="「何が変わったか」を書き出します。" />
                                <CheckBox Content="異なる行だけ" IsChecked="{Binding OnlyDifferences}"
                                          VerticalAlignment="Center" Margin="0,0,12,2" />

                                <!-- 差分をたどる。長い設定では目で探すのが現実的でない -->
                                <Button Content="◀ 前の差分" Command="{Binding PreviousDifferenceCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,4,2"
                                        ToolTip="前の差分へ移ります。先頭まで来たら末尾へ回ります。" />
                                <Button Content="次の差分 ▶" Command="{Binding NextDifferenceCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,8,2"
                                        ToolTip="次の差分へ移ります。末尾まで来たら先頭へ回ります。" />
                                <TextBlock Text="{Binding PositionText}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                            </WrapPanel>

                            <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" />
                            <!-- どの対象を貼り終えたか。作業前の取りこぼしに気づけるように -->
                            <TextBlock Text="{Binding PastedSummary}" TextWrapping="Wrap" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Info.Fg}" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- 読むときの注意。Style は属性と要素の両方には書けないので、
                                 見た目もまとめてここで指定する -->
                            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNote}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Headline}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <!--
                            貼り付け欄と結果は同じ場所に重ねる。
                            DockPanel は最後の子だけが残りを埋めるので、この入れ物を最後に置かないと
                            貼り付け欄が中身の高さまで縮んでしまう（show run を貼るには狭すぎた）。
                        -->
                        <Grid>
                            <!-- 貼り付け欄 -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="11" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                </Grid.ColumnDefinitions>

                                <Thumb Grid.Column="1" Style="{StaticResource PaneGrip.V}" DragStarted="OnPaneGrab" DragDelta="OnPaneDrag" />

                                <DockPanel Grid.Column="0" Margin="0,0,5,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="作業前" VerticalAlignment="Center" />
                                        <Button Content="ファイルから" Command="{Binding LoadBeforeCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="10,0,0,0" />
                                        <Button Content="機器から" Click="OnDiffFetchBefore"
                                                Style="{StaticResource Button.Subtle}" Margin="5,0,0,0"
                                                ToolTip="機器へ入って、比較する対象の show を 1 本流し、その出力をこの欄に入れます。" />
                                        <Button Content="テキストで保存" Command="{Binding SaveBeforeCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="5,0,0,0" />
                                    </StackPanel>
                                    <TextBox Text="{Binding BeforeText, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{DynamicResource Font.Mono}"
                                             FontSize="{DynamicResource Size.Caption}"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top" MinHeight="180"
                                             AllowDrop="True"
                                             PreviewDragOver="OnTextDragOver" Drop="OnTextDrop"
                                             ToolTip="機器から落とした設定のファイルを、この欄に放り込んでも読み込めます（いまの内容は置き換わります）。" />
                                </DockPanel>

                                <DockPanel Grid.Column="2" Margin="5,0,0,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="作業後" VerticalAlignment="Center" />
                                        <Button Content="ファイルから" Command="{Binding LoadAfterCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="10,0,0,0" />
                                        <Button Content="機器から" Click="OnDiffFetchAfter"
                                                Style="{StaticResource Button.Subtle}" Margin="5,0,0,0"
                                                ToolTip="機器へ入って、比較する対象の show を 1 本流し、その出力をこの欄に入れます。" />
                                        <Button Content="テキストで保存" Command="{Binding SaveAfterCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="5,0,0,0" />
                                    </StackPanel>
                                    <TextBox Text="{Binding AfterText, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{DynamicResource Font.Mono}"
                                             FontSize="{DynamicResource Size.Caption}"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top" MinHeight="180"
                                             AllowDrop="True"
                                             PreviewDragOver="OnTextDragOver" Drop="OnTextDrop"
                                             ToolTip="機器から落とした設定のファイルを、この欄に放り込んでも読み込めます（いまの内容は置き換わります）。" />
                                </DockPanel>
                            </Grid>

                            <!-- 結果 -->
                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <!-- 経路として見た変化。行の差分より先に見てほしい -->
                                <Border DockPanel.Dock="Top" Margin="0,0,0,5" Padding="7,5"
                                        Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.Card}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasStructuredView}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <DockPanel MaxHeight="180">
                                        <TextBlock DockPanel.Dock="Top" Text="何が変わったか"
 Margin="0,0,0,4" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Changes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock x:Name="ChangeText" Text="{Binding Description}"
                                                                   TextWrapping="Wrap" Margin="0,0,0,2" />
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                <Setter TargetName="ChangeText" Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                                                                <Setter TargetName="ChangeText" Property="FontWeight" Value="Normal" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                <Setter TargetName="ChangeText" Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!--
                                    左右の見出しと一覧を 1 つの Grid に載せる（2026-08-20 の UX 改善）。
                                    仕切り（GridSplitter）で比率を動かしたとき、見出しが一覧と同じ列に
                                    居ないと付いてこない。**別々の Grid に戻さないこと。**
                                    中の 11 は 貼り付け欄と同じ左右 5px ＋ 罫線 1px。
                                -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" MinHeight="80" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                        <ColumnDefinition Width="11" />
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="作業前" Style="{StaticResource Caption}" Margin="42,0,0,3" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="作業後" Style="{StaticResource Caption}" Margin="42,0,0,3" />
                                    <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1"
                                            Background="{DynamicResource Brush.Border}" Margin="0,0,0,2" />

<ListBox x:Name="DiffList" Grid.Row="2"
                                                 Grid.Column="0"
                                                 Tag="{Binding ElementName=DiffListAfter}"
                                                 ItemsSource="{Binding Rows}"
                                                 ItemContainerStyle="{StaticResource PlainCompactContainer}"
                                                 SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                 ScrollViewer.ScrollChanged="OnDiffPaneScrolled"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemTemplate>
                                                <StaticResource ResourceKey="DiffRow.Left" />
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                    <!-- 作業前と作業後の区切り。左右の余白は貼り付け欄と同じ 5px -->
                                    <Border Grid.Row="2" Grid.Column="1" Width="1" Margin="5,0"
                                            Background="{DynamicResource Brush.Border}" IsHitTestVisible="False" />
                                    <!-- 比率の仕切り。掴みやすいよう 11px 全部を当たり判定にする -->
                                    <Thumb Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                           Style="{StaticResource PaneGrip.V}"
                                           DragStarted="OnPaneGrab" DragDelta="OnPaneDrag" />

<ListBox x:Name="DiffListAfter" Grid.Row="2"
                                                 Grid.Column="2"
                                                 Tag="{Binding ElementName=DiffList}"
                                                 ItemsSource="{Binding Rows}"
                                                 ItemContainerStyle="{StaticResource PlainCompactContainer}"
                                                 SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                 ScrollViewer.ScrollChanged="OnDiffPaneScrolled"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemTemplate>
                                                <StaticResource ResourceKey="DiffRow.Right" />
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                </Grid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== IP設定（この PC の IPv4 設定を切り替える。適用時だけ UAC 昇格） ===== -->
            <TabItem x:Name="IpConfigTab" Header="IP設定" DataContext="{Binding IpConfig}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="{x:Static help:TabHelp.IpConfig}" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="この PC の IP アドレスとプロキシを切り替えます。" />
                        </DockPanel>

                        <!--
                            窓が低いと下（プロキシの段）が隠れるので、説明の行だけ残して
                            中身は縦に送れるようにする（2026-08-19 ユーザー指示）。
                            横は送らない（今までどおり折り返す）。
                        -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <TextBlock Text="アダプタ" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,2" />
                                    <ComboBox Width="300"
                                              ItemsSource="{Binding Adapters}"
                                              SelectedItem="{Binding SelectedAdapter}"
                                              Margin="0,0,6,2"
                                              ToolTip="設定するアダプタ。抜けている(未接続の)アダプタも選べます。">
                                        <!-- 閉じているときの表示に DisplayMemberPath は効かないので ItemTemplate を明示する -->
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Summary, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="再読み込み" Command="{Binding RefreshCommand}"
                                            Style="{StaticResource Button.Subtle}" Margin="0,0,0,2" />
                                </WrapPanel>

                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           Text="{Binding SelectedAdapter.Description}" />

                                <CheckBox DockPanel.Dock="Top" Content="DHCP で自動取得する" IsChecked="{Binding UseDhcp}"
                                          Margin="0,0,0,6"
                                          ToolTip="チェックを外すと下の固定 IP 設定を使います。" />

                                <!-- グレーアウトは分かりづらい(ユーザー指摘)ので、DHCP のときは丸ごと畳む -->
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,4"
                                      Visibility="{Binding UseStatic, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="IP アドレス" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{DynamicResource Font.Mono}" Margin="0,0,0,4" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="マスク" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Mask, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{DynamicResource Font.Mono}" Margin="0,0,0,4"
                                             ToolTip="255.255.255.0 でも 24 でも /24 でも書けます。" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="ゲートウェイ" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{DynamicResource Font.Mono}" Margin="0,0,0,4"
                                             ToolTip="空欄ならゲートウェイなしで設定します。" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="優先 DNS" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Dns1, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{DynamicResource Font.Mono}" Margin="0,0,0,4" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="代替 DNS" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Dns2, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{DynamicResource Font.Mono}" Margin="0,0,0,4"
                                             ToolTip="DNS を両方空欄にすると、DNS の設定はクリアされます。" />
                                </Grid>

                                <TextBlock DockPanel.Dock="Top" Text="{Binding ValidationText}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Foreground="{DynamicResource Brush.Warn.Fg}" />

                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="プリセット" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,2" />
                                    <ComboBox Width="160"
                                              ItemsSource="{Binding Presets}"
                                              SelectedItem="{Binding SelectedPreset}"
                                              Margin="0,0,5,2"
                                              ToolTip="選ぶと内容が入力欄に入ります(適用はされません)。">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <!-- 同じものを選び直しても通知は飛ばないので、入れ直す口を分けてある -->
                                    <Button Content="入れ直す" Command="{Binding LoadPresetCommand}"
                                            Style="{StaticResource Button.Subtle}" Margin="0,0,8,2"
                                            ToolTip="入力欄を、選んでいるプリセットの値に戻します(適用はされません)。" />
                                    <TextBlock Text="名前" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,2" />
                                    <TextBox Width="120" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,6,2" ToolTip="現場名など(例: 現場A)。同じ名前は上書きされます。" />
                                    <Button Content="保存" Command="{Binding SavePresetCommand}"
                                            Style="{StaticResource Button.Subtle}" Margin="0,0,5,2"
                                            ToolTip="いまの入力内容をこの名前で保存します。" />
                                    <Button Content="削除" Command="{Binding DeletePresetCommand}"
                                            Style="{StaticResource Button.Subtle}" Margin="0,0,0,2" />
                                </WrapPanel>

                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="適用" Click="OnApplyIpConfig" IsEnabled="{Binding CanApply}"
                                            Margin="0,0,12,0"
                                            ToolTip="確認の後、UAC の昇格を経て netsh で設定します。" />
                                    <TextBlock Text="{Binding ResultText}"
                                               VerticalAlignment="Center" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResultKind}" Value="Ok">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ResultKind}" Value="Alert">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           Text="適用には管理者権限が必要です(UAC の確認が 1 回出ます)。アプリ自体は非管理者のまま動きます。この PC の通信が一時的に切れることがあります。" />

                                <!-- ===== プロキシ =====
                                     上段は WinINET(ログインしたユーザーの設定。ブラウザが従う。管理者権限は不要)。
                                     下段は WinHTTP(PC 全体で 1 つ。サービスや .NET のアプリが従う。適用は昇格が要る) -->
                                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,8,0,8" />

                                <StackPanel DockPanel.Dock="Top" DataContext="{Binding Proxy}">
                                    <WrapPanel Margin="0,0,0,4">
                                        <TextBlock Text="プロキシ" VerticalAlignment="Center" Margin="0,0,8,2" />
                                        <ComboBox Width="190"
                                                  ItemsSource="{Binding Modes}"
                                                  SelectedItem="{Binding SelectedMode}"
                                                  Margin="0,0,8,2">
                                            <!-- 閉じているときの表示に DisplayMemberPath は効かないので ItemTemplate を明示する -->
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding CurrentSummary}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CurrentSummary}" Margin="0,0,0,2" />
                                    </WrapPanel>

                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Text="この欄はブラウザが従う設定（ログインしたユーザーごと）です。管理者権限は要りません。" />

                                    <!-- 選んだ方式の行だけ出す(グレーアウトは分かりづらい、というユーザー指摘) -->
                                    <WrapPanel Margin="0,0,0,4"
                                               Visibility="{Binding IsPac, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="PAC の URL" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,2" />
                                        <TextBox Width="320" Text="{Binding PacUrl, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Font.Mono}" Margin="0,0,0,2"
                                                 ToolTip="例: http://proxy.example.co.jp/proxy.pac" />
                                    </WrapPanel>

                                    <WrapPanel Margin="0,0,0,4"
                                               Visibility="{Binding IsFixed, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="サーバ" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,2" />
                                        <TextBox Width="200" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Font.Mono}" Margin="0,0,10,2"
                                                 ToolTip="例: proxy.example.co.jp:8080(プロトコル別は http=…;https=… の書式)" />
                                        <TextBlock Text="除外" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,2" />
                                        <TextBox Width="220" Text="{Binding Bypass, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Font.Mono}" Margin="0,0,0,2"
                                                 ToolTip="プロキシを通さない宛先。; 区切り。&lt;local&gt; はローカルアドレスの意味。" />
                                    </WrapPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="プロキシを適用" Command="{Binding ApplyCommand}" Margin="0,0,12,0"
                                                ToolTip="Windows のプロキシ設定(現在のユーザー)に反映します。管理者権限は不要です。" />
                                        <TextBlock Text="{Binding ResultText}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ResultKind}" Value="Ok">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ResultKind}" Value="Alert">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!--
                                        WinHTTP は PC 全体で 1 つの別設定。サービスとして動くもの
                                        (Windows Update・監視エージェント・.NET のアプリ)はこちらに従う。
                                        「ブラウザは見えるのに更新だけ外に出られない」の典型的な原因で、
                                        画面から確かめる手段が無いまま放置されやすい。
                                    -->
                                    <Border Background="{DynamicResource Brush.SurfaceAlt}"
                                            CornerRadius="{DynamicResource Radius.Control}"
                                            Padding="8,6" Margin="0,10,0,0">
                                        <StackPanel>
                                            <WrapPanel Margin="0,0,0,4">
                                                <TextBlock Text="WinHTTP（PC 全体）" VerticalAlignment="Center" Margin="0,0,8,2" />
                                                <TextBlock Text="{Binding WinHttpSummary}" Style="{StaticResource Caption}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding WinHttpSummary}" Margin="0,0,0,2" />
                                            </WrapPanel>

                                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Text="サービスとして動くもの（Windows Update・監視エージェント・.NET のアプリ）が従う設定です。ブラウザは見えるのに更新やエージェントだけ外に出られない、というときはここを確かめてください。適用には管理者権限が要ります（UAC の確認が 1 回出ます）。" />

                                            <!-- 上段とは別の設定なので、選び方も入力欄もこちらで持つ。
                                                 PAC は WinHTTP が持てない仕様なので選択肢に出さない -->
                                            <WrapPanel Margin="0,0,0,4">
                                                <TextBlock Text="方式" Style="{StaticResource Caption}"
                                                           VerticalAlignment="Center" Margin="0,0,5,2" />
                                                <ComboBox Width="190"
                                                          ItemsSource="{Binding WinHttpModes}"
                                                          SelectedItem="{Binding SelectedWinHttpMode}"
                                                          Margin="0,0,8,2"
                                                          ToolTip="WinHTTP は PAC（自動構成スクリプト）を扱えません。PAC の現場では、PAC が返す代表的なプロキシを「固定」で入れてください。">
                                                    <!-- 閉じているときの表示に DisplayMemberPath は効かない -->
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </WrapPanel>

                                            <!-- 選んだ方式の行だけ出す(グレーアウトは分かりづらい、というユーザー指摘) -->
                                            <WrapPanel Margin="0,0,0,4"
                                                       Visibility="{Binding WinHttpIsFixed, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="サーバ" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,2" />
                                                <TextBox Width="200" Text="{Binding WinHttpServer, UpdateSourceTrigger=PropertyChanged}"
                                                         FontFamily="{DynamicResource Font.Mono}" Margin="0,0,10,2"
                                                         ToolTip="例: proxy.example.co.jp:8080" />
                                                <TextBlock Text="除外" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,2" />
                                                <TextBox Width="220" Text="{Binding WinHttpBypass, UpdateSourceTrigger=PropertyChanged}"
                                                         FontFamily="{DynamicResource Font.Mono}" Margin="0,0,0,2"
                                                         ToolTip="プロキシを通さない宛先。; 区切り。&lt;local&gt; はローカルアドレスの意味。" />
                                            </WrapPanel>

                                            <Button Content="WinHTTP に適用" HorizontalAlignment="Left"
                                                    Command="{Binding ApplyWinHttpCommand}"
                                                    ToolTip="この欄の内容を PC 全体の WinHTTP 設定に反映します。UAC の確認が 1 回出ます。" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border />
                            </DockPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 記録 ===== -->
            <!-- ===== 試験（業務確認試験。プロキシを切り替えて同じ試験を回せる） ===== -->
            <TabItem x:Name="VerifyTab" Header="業務確認" DataContext="{Binding Verify}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="{x:Static help:TabHelp.Verify}" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="Web・Teams・メールが使えるかをまとめて試験します。" />
                        </DockPanel>

                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <ComboBox Width="200" Margin="0,0,6,2"
                                      ItemsSource="{Binding Templates}"
                                      SelectedItem="{Binding SelectedTemplate}"
                                      ToolTip="試験項目のひな型です。入れてから宛先を書き換えます。">
                                <!-- 閉じているときの表示に DisplayMemberPath は効かない -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="ひな型を入れる" Command="{Binding ApplyTemplateCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                    ToolTip="いまの項目を置き換えます。" />

                            <!-- 現場ごとに試す項目は決まっている。毎回書き直させない -->
                            <Button Content="ひな型に残す" Command="{Binding SaveTemplateCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                    ToolTip="いまの項目に名前を付けて、ひな型の一覧に残します（★ が付きます）。同じ名前で上書きもできます。" />
                            <Button Content="ひな型を消す" Command="{Binding DeleteTemplateCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,16,2"
                                    ToolTip="選んでいる自作のひな型（★）を消します（確認が出ます）。組み込みのひな型は消せません。" />

                            <Button Content="項目を読み込む" Command="{Binding LoadItemsCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                    ToolTip="保存しておいた試験項目のファイルを読み込みます（いまの項目は置き換わります）。一覧にファイルを放り込んでも読み込めます。" />
                            <Button Content="項目を保存" Command="{Binding SaveItemsCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,16,2"
                                    ToolTip="いまの試験項目をファイルに保存します。現場ごとに使い分けたり、人に渡したりできます。" />

                            <Button Content="まとめて実行" Command="{Binding StartCommand}" Margin="0,0,6,2" />
                            <!-- 手で切り分けるとき用。1 項目だけ、選んだプロキシで試す -->
                            <Button Content="選んだ項目だけ試す" Click="OnVerifyRunOne"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                    ToolTip="一覧で選んでいる 1 項目を、押したときに選ぶプロキシで試します。" />
                            <Button Content="中断" Command="{Binding CancelCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2" />
                            <!-- 報告書はファイルメニューと同じもの（測定の結果も一緒に入る）。
                                 ここだけ別のものが出ると、どちらを渡したのか分からなくなる
                                 （2026-08-18 ユーザー指示） -->
                            <Button Content="HTML で保存"
                                    Command="{Binding DataContext.Report.SaveHtmlCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,0,2"
                                    ToolTip="そのままメールに添付できる報告書にします（ファイルメニューの「レポートを HTML で保存」と同じもの）。" />
                        </WrapPanel>

                        <!--
                            プロキシ。<b>試す先を横に並べて、既定で全部見えるようにする</b>
                            （2026-08-18 ユーザー指示。右の欄に縦積みしていたので、
                            数本あるとスクロールしないと見えなかった）。
                            定義（テキスト）は普段畳んでおく — 書き換えるのは最初だけ。
                        -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,6"
                                Background="{DynamicResource Brush.Surface}"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top">
                                    <TextBlock Text="試すプロキシ" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="0,0,10,3"
                                               ToolTip="チェックしたプロキシごとに、同じ試験を 1 周ずつ回します。入れ替えの前後を並べて比べるための機能です。" />

                                    <ItemsControl ItemsSource="{Binding Proxies}" Margin="0,0,10,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          Margin="0,0,14,3"
                                                          Content="{Binding Name}" ToolTip="{Binding Summary}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ToggleButton x:Name="ProxyListToggle" Content="一覧を編集 ▾"
                                                  Style="{StaticResource ToggleButton.Subtle}"
                                                  Margin="0,0,0,3"
                                                  ToolTip="プロキシの定義（名前・種類・アドレス）を書き換える欄を開きます。" />
                                </WrapPanel>

                                <DockPanel DockPanel.Dock="Top" Margin="0,6,0,0"
                                           Visibility="{Binding IsChecked, ElementName=ProxyListToggle,
                                                        Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,3"
                                               Text="プロキシの一覧（1 行 1 件・名前,pac または proxy,アドレス。アドレスだけでも可）" />
                                    <TextBox Text="{Binding ProxyText, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{DynamicResource Font.Mono}"
                                             FontSize="{DynamicResource Size.Caption}"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             Height="66"
                                             VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"
                                             ToolTip="例: Zscaler,pac,http://pac.zscaler.net/example/proxy.pac&#10;アドレスだけ書いても構いません（.pac で終われば PAC、それ以外はプロキシとして扱います）。" />
                                </DockPanel>
                            </DockPanel>
                        </Border>

                        <!--
                            項目と結果を上下に置く。
                            <b>項目の側は結果より小さく取る</b>（2026-08-17 ユーザー指示）。
                            上にはひな型・プロキシの設定も載っていて、それらを合わせた「設定するところ」が
                            結果と同じくらいの背丈に見えるようにするため。窓を広げれば両方が伸びる。
                        -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0.7*" MinHeight="64" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="*" MinHeight="80" />
                            </Grid.RowDefinitions>

                            <!-- 上: 試験項目（編集）。窓の幅が足りないので結果とは縦に積む。
                                 項目のファイルはここへ放り込んでも読み込める -->
                            <Border Grid.Row="0" Margin="0,0,0,6"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="6"
                                    AllowDrop="True" DragOver="OnListDragOver" Drop="OnVerifyItemsDrop">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="4,0,18,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.0]}" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.2]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.3]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.4]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.5]}" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <TextBlock Grid.Column="0" Text="削除" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="1" Text="項目名" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="2" Text="種類" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="3" Text="宛先" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="4" Text="期待" Style="{StaticResource Caption}"
                                                   ToolTip="本文にこの文字列が含まれることまで確かめます（HTTP のみ）。遮断ページを合格と誤読しないための確実な手です。" />
                                        <TextBlock Grid.Column="5" Text="結果" Style="{StaticResource Caption}" />
                                        <!-- 列幅のつまみ。星列(1)より左は右端、右は左端の境界に置く -->
                                        <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                               Tag="verify.0" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="verify.2" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="verify.3" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="4" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="verify.4" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="5" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="verify.5" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                    </Grid>
                                    <Border DockPanel.Dock="Top" Height="1"
                                            Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />

                                    <!-- 「行を追加」を先に下端へ留めてから、一覧に残りを埋めさせる -->
                                    <Button DockPanel.Dock="Bottom" Content="＋ 行を追加"
                                            Command="{Binding AddRowCommand}"
                                            Style="{StaticResource Button.Subtle}"
                                            HorizontalAlignment="Left" Margin="4,4,0,0" />

                                    <!-- 行はつまみ（⋮）を掴んでドラッグすると並べ替えられる。
                                         入力欄からは掴めないようにしてある（文字の選択と喧嘩するため） -->
                                    <ListBox x:Name="VerifyItems" ItemsSource="{Binding Rows}"
                                             Background="Transparent" BorderThickness="0"
                                             HorizontalContentAlignment="Stretch"
                                             ItemContainerStyle="{StaticResource PlainRowContainer}"
                                             AllowDrop="True"
                                             PreviewMouseMove="OnVerifyRowDrag"
                                             DragOver="OnVerifyRowDragOver"
                                             Drop="OnVerifyRowDrop"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Visible">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="{DynamicResource Size.RowHeight.Input}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.0]}" />
                                                        <ColumnDefinition Width="*" MinWidth="120" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.2]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.3]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.4]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.5]}" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <!-- 並べ替えのつまみ（2026-08-19 ユーザー指示） -->
                                                        <TextBlock Text="⋮" Width="12" Cursor="SizeAll"
                                                                   Background="Transparent"
                                                                   FontSize="{DynamicResource Size.Body}"
                                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                                   TextAlignment="Center" VerticalAlignment="Center"
                                                                   PreviewMouseLeftButtonDown="OnVerifyRowGrab"
                                                                   ToolTip="ドラッグすると行を並べ替えられます。" />

                                                        <Button Content="✕"
                                                                Style="{StaticResource Button.Subtle}"
                                                                Command="{Binding DataContext.RemoveRowCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"
                                                                Width="16" Height="16"
                                                                Padding="0" MinWidth="0" MinHeight="0"
                                                                FontSize="{DynamicResource Size.Micro}"
                                                                Margin="2,0,0,0"
                                                                ToolTip="この行を消します。" />

                                                        <!-- 手で切り分けるとき用。1 項目だけ、選んだプロキシで試す
                                                             （2026-08-18 ユーザー指示） -->
                                                        <Button Content="▶"
                                                                Style="{StaticResource Button.Subtle}"
                                                                Click="OnVerifyRunOne"
                                                                Width="16" Height="16"
                                                                Padding="0" MinWidth="0" MinHeight="0"
                                                                FontSize="{DynamicResource Size.Micro}"
                                                                Margin="3,0,0,0"
                                                                ToolTip="この項目だけを、選んだプロキシで試します。" />
                                                    </StackPanel>

                                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="{DynamicResource Size.Caption}"
                                                             Margin="0,0,4,0" VerticalAlignment="Center"
                                                             ToolTip="試験成績書にそのまま出る名前です。" />

                                                    <ComboBox Grid.Column="2"
                                                              ItemsSource="{Binding Kinds}"
                                                              SelectedItem="{Binding Kind}"
                                                              FontSize="{DynamicResource Size.Caption}"
                                                              VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <!-- 閉じているときの表示に DisplayMemberPath は効かない -->
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <TextBox Grid.Column="3" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                             FontFamily="{DynamicResource Font.Mono}"
                                                             FontSize="{DynamicResource Size.Caption}"
                                                             Margin="0,0,4,0" VerticalAlignment="Center"
                                                             ToolTip="{Binding TargetHint}" />

                                                    <TextBox Grid.Column="4" Text="{Binding Expect, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="{DynamicResource Size.Caption}"
                                                             Margin="0,0,4,0" VerticalAlignment="Center"
                                                             ToolTip="本文にこの文字列が含まれることまで確かめます（HTTP のみ）。" />

                                                    <TextBlock Grid.Column="5" Text="{Binding Status}"
                                                               FontSize="{DynamicResource Size.Caption}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Status}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- 下: 結果。1 行 = 1 項目 × 1 プロキシ -->
                            <Thumb Grid.Row="1" Style="{StaticResource PaneGrip.H}" DragStarted="OnPaneGrab" DragDelta="OnPaneDrag" />

                            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
                                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                <DockPanel>
                                    <!--
                                        見出し・進み具合・合否の内訳・状態を 1 行に詰める。
                                        この画面は情報が多いので、独立した進捗カードは置かない
                                        （2026-08-16 ユーザー指示。以前は上に 60px ほど占めていた）。
                                    -->
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,3">
                                        <TextBlock DockPanel.Dock="Left" Text="結果"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"
                                                   ToolTip="1 行 = 1 項目 × 1 プロキシ" />

                                        <!-- 何件まで済んだか。実行していないときは空 -->
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   Margin="10,0,0,0" TextAlignment="Right" />

                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                                    Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">
                                            <Border Style="{StaticResource Badge}" Margin="0,0,4,0"
                                                    Background="{DynamicResource Brush.Ok.Bg}">
                                                <TextBlock Style="{StaticResource Badge.Text}"
                                                           Foreground="{DynamicResource Brush.Ok.Fg}">
                                                    <Run Text="○ " /><Run Text="{Binding PassCount, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Margin="0,0,4,0"
                                                    Background="{DynamicResource Brush.Error.Bg}">
                                                <TextBlock Style="{StaticResource Badge.Text}"
                                                           Foreground="{DynamicResource Brush.Error.Fg}">
                                                    <Run Text="✕ " /><Run Text="{Binding FailCount, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Margin="0,0,4,0"
                                                    Background="{DynamicResource Brush.Warn.Bg}">
                                                <TextBlock Style="{StaticResource Badge.Text}"
                                                           Foreground="{DynamicResource Brush.Warn.Fg}">
                                                    <Run Text="△ " /><Run Text="{Binding WarnCount, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Margin="0,0,10,0"
                                                    Background="{DynamicResource Brush.Info.Bg}">
                                                <TextBlock Style="{StaticResource Badge.Text}"
                                                           Foreground="{DynamicResource Brush.Info.Fg}">
                                                    <Run Text="◍ " /><Run Text="{Binding PersonCount, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <!-- 実行中は「試験中… 5/12 項目名」、終わると要約や保存の結果 -->
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource ExpandableCell.Caption}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                                    </DockPanel>

                                    <!-- 進み具合。細く 1 本引くだけで、押したあと動いていることは伝わる -->
                                    <ProgressBar DockPanel.Dock="Top" Style="{StaticResource BusyBar}"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"
                                                 Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid DockPanel.Dock="Top" Margin="4,0,18,3" Background="Transparent"
                                          Tag="vres" MouseLeftButtonDown="OnTableHeaderSort"
                                      Cursor="Hand" ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[vres.0]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[vres.1]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[vres.2]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[vres.3]}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <TextBlock Grid.Column="0" Text="項目" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="1" Text="プロキシ" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="2" Text="合否" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="3" Text="所要" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="4" Text="詳細" Style="{StaticResource Caption}" />
                                        <!-- 列幅のつまみ。星列(4)より左なので右端の境界に置く -->
                                        <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                               Tag="vres.0" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                               Tag="vres.1" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                               Tag="vres.2" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                               Tag="vres.3" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                    </Grid>
                                    <Border DockPanel.Dock="Top" Height="1"
                                            Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />

                                    <!-- TargetListBox は Ping 用の ItemTemplate を既定で当ててくるので使わない。
                                         ここは自前のテンプレートを 1 つ置くだけ -->
                                    <Grid>
                                    <ListBox x:Name="VerifyResultList" ItemsSource="{Binding Results}" Tag="vres"
                                             Background="Transparent" BorderThickness="0"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             ItemContainerStyle="{StaticResource PlainRowContainer}"
                                             ScrollViewer.VerticalScrollBarVisibility="Visible">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="{DynamicResource Size.RowHeight}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[vres.0]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[vres.1]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[vres.2]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[vres.3]}" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                               FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ProxyText}"
                                                               FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ProxyText}" />
                                                    <TextBlock x:Name="VerdictText" Grid.Column="2" Text="{Binding VerdictText}"
                                                               FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" />

                                                    <!-- 目視の項目だけ、その場で合否を付けられるようにする。
                                                         アプリからは判定できないページがあるため -->
                                                    <StackPanel x:Name="MarkButtons" Grid.Column="2" Orientation="Horizontal"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Visibility="Collapsed">
                                                        <Button Content="○" Margin="0,0,2,0"
                                                                Width="18" Height="16" Padding="0" MinWidth="0" MinHeight="0"
                                                                FontSize="{DynamicResource Size.Micro}"
                                                                Style="{StaticResource Button.Subtle}"
                                                                Command="{Binding DataContext.MarkPassCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="目視で確認できたので合格にします。" />
                                                        <Button Content="✕"
                                                                Width="18" Height="16" Padding="0" MinWidth="0" MinHeight="0"
                                                                FontSize="{DynamicResource Size.Micro}"
                                                                Style="{StaticResource Button.Subtle}"
                                                                Command="{Binding DataContext.MarkFailCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="目視で問題があったので不合格にします。" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding ElapsedText}" Style="{StaticResource Mono}"
                                                               FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                               HorizontalAlignment="Right" Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Detail}"
                                                               Style="{StaticResource ExpandableCell}"
                                                               FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                                </Grid>

                                                <!-- 合否は文字で出したうえで色を添える（色だけで表さない） -->
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsFail}" Value="True">
                                                        <Setter TargetName="VerdictText" Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                                        <Setter TargetName="VerdictText" Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NeedsPerson}" Value="True">
                                                        <Setter TargetName="VerdictText" Property="Foreground" Value="{DynamicResource Brush.Info.Fg}" />
                                                        <Setter TargetName="MarkButtons" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPass}" Value="True">
                                                        <Setter TargetName="VerdictText" Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                        <TextBlock Style="{StaticResource EmptyHint}"
                                                   Text="「まとめて実行」を押すと、結果がここに並びます"
                                                   Visibility="{Binding Items.Count, ElementName=VerifyResultList, Converter={StaticResource ZeroToVisible}}" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 無線 ===== -->
            <TabItem x:Name="WifiTab" Header="Wi-Fi" DataContext="{Binding Wifi}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="{x:Static help:TabHelp.Wifi}" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="つないでいる Wi-Fi の電波の強さと、周りの混み具合を見ます。" />
                        </DockPanel>


                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal">
                                <!-- SSID が長い環境でボタンが押し出されないよう幅を抑える -->
                                <TextBlock Text="{Binding ConnectionSummary}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           MaxWidth="280" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ConnectionSummary}" />
                                <Button Content="更新" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                                <Button Content="テキストで保存" Command="{Binding SaveCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,10,0"
                                        ToolTip="いまの接続情報と周辺 AP の一覧をテキストで保存します。" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ProgressBar DockPanel.Dock="Top" Style="{StaticResource BusyBar}" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                            <!-- 位置情報が許可されていないときの案内 -->
                            <Border Background="{DynamicResource Brush.Warn.Bg}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="7,5" Margin="0,5,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDenied}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Foreground="{DynamicResource Brush.Warn.Fg}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                               Text="Windows 11 24H2 以降、無線 LAN の情報を読むには位置情報の許可が必要です。設定で「位置情報」を有効にしてから、もう一度お試しください。" />
                                    <Button Content="設定を開く" Command="{Binding OpenLocationSettingsCommand}"
                                            Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 接続中 AP の詳細と RSSI 推移 -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource Brush.SurfaceAlt}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="7,5" Margin="0,0,5,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SSID" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Ssid}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="信号" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Signal}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="BSSID" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Bssid}" Style="{StaticResource Mono}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="チャンネル" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Channel}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="機器" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Vendor}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="規格" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding PhyType}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="暗号化" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Security}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="リンク速度" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding LinkRate}"
                                               ToolTip="ネゴシエートされたリンク速度です。実際の通信速度ではありません。" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="アダプタ" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Adapter}"
                                               Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource Brush.SurfaceAlt}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="7,5" Margin="5,0,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="受信強度の推移（dBm・直近2分）"
                                               Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                    <!-- 読み方の目安。-67 dBm が通話・会議の実用下限としてよく使われる -->
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="目安: -50 以上 非常に良い ／ -60 良い ／ -67 実用圏（通話・会議はここまで） ／ -75 弱い ／ それ未満 不安定" />
                                    <controls:RssiChart Source="{Binding}" MinHeight="86" />
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- チャンネル混雑 -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="7,5" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="チャンネルの混み具合（そのチャンネルを使っている AP の数）"
                                           Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                <!-- 5GHz は 18 本あるので、狭い窓では折り返して縦に積む -->
                                <WrapPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,24,6">
                                        <ItemsControl ItemsSource="{Binding Channels24}" Height="98" VerticalAlignment="Bottom">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Bottom" Width="22">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"
                                                                   HorizontalAlignment="Center" />
                                                        <Border x:Name="Bar" Width="14" Height="{Binding Height}"
                                                                Background="{DynamicResource Brush.Accent.Bg}"
                                                                CornerRadius="0"
                                                                HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding Channel}" Style="{StaticResource Caption}"
                                                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Ok.Bg}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="2.4 GHz" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Channels5}" Height="98" VerticalAlignment="Bottom">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Bottom" Width="30">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"
                                                                   HorizontalAlignment="Center" />
                                                        <Border x:Name="Bar5" Width="18" Height="{Binding Height}"
                                                                Background="{DynamicResource Brush.Info.Bg}"
                                                                CornerRadius="0"
                                                                HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding Channel}" Style="{StaticResource Caption}"
                                                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                            <Setter TargetName="Bar5" Property="Background" Value="{DynamicResource Brush.Ok.Bg}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="5 GHz 以上" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 周辺 AP 一覧 -->
                        <Grid DockPanel.Dock="Top" Margin="4,0,18,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="140" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.1]}" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.2]}" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.3]}" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.4]}" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.5]}" />
                            </Grid.ColumnDefinitions>
                            <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <!-- クリックでソート(昇順→降順→強い順)。透明 Border で列幅いっぱいに受ける -->
                            <Border Grid.Column="0" Background="Transparent" Cursor="Hand" Tag="Ssid"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderSsid}" Style="{StaticResource Caption}" />
                            </Border>
                            <Border Grid.Column="1" Background="Transparent" Cursor="Hand" Tag="Bssid"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderBssid}" Style="{StaticResource Caption}" />
                            </Border>
                            <Border Grid.Column="2" Background="Transparent" Cursor="Hand" Tag="Vendor"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderVendor}" Style="{StaticResource Caption}" />
                            </Border>
                            <Border Grid.Column="3" Background="Transparent" Cursor="Hand" Tag="Rssi"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderRssi}" Style="{StaticResource Caption}" />
                            </Border>
                            <Border Grid.Column="4" Background="Transparent" Cursor="Hand" Tag="Channel"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderChannel}" Style="{StaticResource Caption}" />
                            </Border>
                            <Border Grid.Column="5" Background="Transparent" Cursor="Hand" Tag="Band"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderBand}" Style="{StaticResource Caption}" />
                            </Border>
                            <!-- 列幅のつまみ。星列より左は右端、右は左端の境界に置く -->
                            <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Tag="wifi.1" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                            <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Tag="wifi.2" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                            <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Tag="wifi.3" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                            <Thumb Grid.Column="4" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Tag="wifi.4" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                            <Thumb Grid.Column="5" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Tag="wifi.5" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1"
                                Background="{DynamicResource Brush.Border}" Margin="0,0,0,2" />

                        <ListBox ItemsSource="{Binding AccessPoints}"
                                 ItemContainerStyle="{StaticResource PlainRowContainer}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="{DynamicResource Size.RowHeight}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="140" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.1]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.2]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.3]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.4]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.5]}" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 電波の強さで行を塗る（2026-08-18 ユーザー指示）。
                                             色だけに頼らないよう dBm の数値はそのまま出す。
                                             薄めに敷くのは、選んでいる行が下から透けるようにするため -->
                                        <Border x:Name="RowTint" Grid.ColumnSpan="6" Opacity="0.6" IsHitTestVisible="False" />

                                        <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />

                                        <TextBlock x:Name="SsidText" Grid.Column="0" Text="{Binding Ssid}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Bssid}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Vendor}"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Rssi}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding Channel}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="5" Text="{Binding Band}"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding SeverityKind}" Value="Ok">
                                            <Setter TargetName="RowTint" Property="Background" Value="{DynamicResource Brush.Ok.Bg}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SeverityKind}" Value="Notice">
                                            <Setter TargetName="RowTint" Property="Background" Value="{DynamicResource Brush.Warn.Bg}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SeverityKind}" Value="Alert">
                                            <Setter TargetName="RowTint" Property="Background" Value="{DynamicResource Brush.Error.Bg}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter TargetName="SsidText" Property="FontWeight" Value="Normal" />
                                            <Setter TargetName="SsidText" Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== Meraki(ダッシュボード API からの照会) ===== -->
            <TabItem x:Name="MerakiTab" Header="Meraki" DataContext="{Binding Meraki}">
                <DockPanel>
                    <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                   ToolTip="{x:Static help:TabHelp.Meraki}" />
                        <TextBlock Style="{StaticResource TabIntro}" Text="Meraki ダッシュボードから拠点の状況を取ってきます。" />
                    </DockPanel>

                    <!-- 操作行はサブタブ共通。API キーは伏せ字(画面を PNG 保存できるため) -->
                    <StackPanel DockPanel.Dock="Top" Margin="2,2,0,6">
                        <!-- 畳めるログイン欄。取れたら畳んで、一覧に画面を使う -->
                        <WrapPanel Margin="0,0,0,2">
                            <Button Content="{Binding ConnectionToggleText}" Command="{Binding ToggleConnectionCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,8,0"
                                    ToolTip="接続先の入力欄を開いたり畳んだりします。" />
                            <TextBlock Text="{Binding ConnectionSummary}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </WrapPanel>
                        <WrapPanel Visibility="{Binding ShowConnection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="API キー" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,5,2" />
                            <PasswordBox x:Name="MerakiKeyBox" Width="230" Margin="0,0,12,2"
                                         PasswordChanged="OnMerakiKeyChanged"
                                         ToolTip="ダッシュボードの [My profile] で発行したキー。保存しません。">
                                <PasswordBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding FetchCommand}" />
                                </PasswordBox.InputBindings>
                            </PasswordBox>

                            <!-- 組織を選ぶ必要があることは見落とされやすい。
                                 選ぶまでは見出しごと警告色にする（2026-08-18 ユーザー指示） -->
                            <TextBlock VerticalAlignment="Center" Margin="0,0,5,2">
                                <!-- 文字も色も Style で決める。属性で書くとトリガーが負ける -->
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Text" Value="組織" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NeedsOrganization}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Text" Value="⚠ 組織を選ぶ" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- ComboBox のテンプレートは自前なので、枠は外側の Border で描く -->
                            <Border Margin="0,0,12,2" Padding="2" CornerRadius="{DynamicResource Radius.Control}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NeedsOrganization}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warn.Fg}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ComboBox Width="180"
                                          ItemsSource="{Binding Organizations}"
                                          SelectedItem="{Binding SelectedOrganization}"
                                          ToolTip="組織が複数あるときに選びます。選ぶとそのまま取りに行きます。">
                                    <!-- 閉じているときの表示に DisplayMemberPath は効かない -->
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Border>

                            <Button Content="取得" Command="{Binding FetchCommand}" Margin="0,0,6,2" />
                            <Button Content="中断" Command="{Binding CancelCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,0,2" />
                        </WrapPanel>
                        <ProgressBar DockPanel.Dock="Top" Style="{StaticResource BusyBar}" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource Brush.Warn.Fg}" TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- 中の切り替えも主タブと同じ見た目にする（2026-08-16 ユーザー指示）。
                         暗黙の TabItem スタイルに任せるので、ここでは何も当てない -->
                    <TabControl x:Name="MerakiSubTabs" BorderThickness="0" Padding="0">

                        <!-- 導入時確認(入れた日に、その拠点が正常に導入されたかを一通り見る) -->
                        <TabItem Header="導入時確認">
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                                   ToolTip="{x:Static help:TabHelp.MerakiInstallCheck}" />
                                        <TextBlock Style="{StaticResource TabIntro}" Text="選んだ拠点が正常に導入されたかを、項目ごとに ○ か ✕ で確かめます。" />
                                    </DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="拠点" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <ComboBox Width="180" Margin="0,0,12,0"
                                                  ItemsSource="{Binding NetworkRows}"
                                                  SelectedItem="{Binding SelectedNetwork}"
                                                  ToolTip="入れたばかりの拠点を 1 つ選びます。">
                                            <!-- 閉じているときの表示に DisplayMemberPath は効かない -->
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="確認する" Command="{Binding FetchInstallCheckCommand}" Margin="0,0,6,0"
                                                ToolTip="7 項目を順に確かめます。機器や回線をまだ取っていなければ、この中で取りに行きます。" />
                                        <Button Content="Excel で保存" Command="{Binding SaveXlsxCommand}"
                                                CommandParameter="check" Margin="0,0,6,0"
                                                ToolTip="絞り込みと見出し行の固定を付けた .xlsx で保存します。" />
                                        <Button Content="CSV で保存" Command="{Binding SaveInstallCheckCommand}"
                                                Style="{StaticResource Button.Subtle}"
                                                ToolTip="判定をそのまま証跡として残せます。" />
                                    </StackPanel>
                                <Border Background="{DynamicResource Brush.Surface}"
                                        BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                        CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="4,0,18,3" Background="Transparent" Tag="mrcheck" MouseLeftButtonDown="OnTableHeaderSort"
                                      Cursor="Hand" ToolTip="クリックで並べ替え（もう一度で逆順）">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mrcheck.0]}" />
                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mrcheck.1]}" />
                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mrcheck.2]}" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                            <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                            <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                            <TextBlock Grid.Column="0" Text="項目" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="1" Text="対象" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="2" Text="判定" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="3" Text="詳細" Style="{StaticResource Caption}" />
                                            <!-- 星列より左は右端の境界につまみを置く -->
                                            <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                                   Tag="mrcheck.0" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                            <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                                   Tag="mrcheck.1" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                            <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                                   Tag="mrcheck.2" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                        </Grid>
                                        <Border DockPanel.Dock="Top" Height="1"
                                                Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />
                                        <ListBox Tag="mrcheck" ItemsSource="{Binding CheckRows}"
                                                 ItemContainerStyle="{StaticResource PlainRowContainer}"
                                                 Background="Transparent" BorderThickness="0"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 ScrollViewer.VerticalScrollBarVisibility="Visible">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="{DynamicResource Size.RowHeight.Wide}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mrcheck.0]}" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mrcheck.1]}" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mrcheck.2]}" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                        <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                        <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                   FontSize="{DynamicResource Size.Caption}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Target}"
                                                                   FontSize="{DynamicResource Size.Caption}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Target}" />
                                                        <TextBlock x:Name="CheckVerdictText" Grid.Column="2" Text="{Binding VerdictText}"
                                                                   FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" />

                                                        <!-- API から判定できない項目だけ、その場で合否を付けられるようにする -->
                                                        <StackPanel x:Name="CheckMarkButtons" Grid.Column="2" Orientation="Horizontal"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                    Visibility="Collapsed">
                                                            <Button Content="○" Margin="0,0,2,0"
                                                                    Width="18" Height="16" Padding="0" MinWidth="0" MinHeight="0"
                                                                    FontSize="{DynamicResource Size.Micro}"
                                                                    Style="{StaticResource Button.Subtle}"
                                                                    Command="{Binding DataContext.MarkCheckPassCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="目視で確認できたので合格にします。" />
                                                            <Button Content="✕"
                                                                    Width="18" Height="16" Padding="0" MinWidth="0" MinHeight="0"
                                                                    FontSize="{DynamicResource Size.Micro}"
                                                                    Style="{StaticResource Button.Subtle}"
                                                                    Command="{Binding DataContext.MarkCheckFailCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="目視で問題があったので不合格にします。" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding Detail}"
                                                                   Style="{StaticResource ExpandableCell}"
                                                                   FontSize="{DynamicResource Size.Caption}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Detail}" />
                                                    </Grid>

                                                    <!-- 合否は文字で出したうえで色を添える(色だけで表さない) -->
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsFail}" Value="True">
                                                            <Setter TargetName="CheckVerdictText" Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                                            <Setter TargetName="CheckVerdictText" Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NeedsPerson}" Value="True">
                                                            <Setter TargetName="CheckVerdictText" Property="Foreground" Value="{DynamicResource Brush.Info.Fg}" />
                                                            <Setter TargetName="CheckMarkButtons" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPass}" Value="True">
                                                            <Setter TargetName="CheckVerdictText" Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                                </DockPanel>
                            </Border>
                        </TabItem>

                        <!-- 機器 -->
                        <TabItem Header="機器">
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                                   ToolTip="{x:Static help:TabHelp.MerakiDevices}" />
                                        <TextBlock Style="{StaticResource TabIntro}" Text="機器を一覧にします。拠点で絞るか、全拠点かを選べます。" />
                                    </DockPanel>

                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <!-- どのサブタブでも同じ選択（2026-08-18 ユーザー指示）。
                                             取ってあるものを絞るだけなので、選び直しても取り直さない -->
                                        <TextBlock Text="拠点" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <ComboBox Width="180" Margin="0,0,6,0"
                                                  ItemsSource="{Binding NetworkRows}"
                                                  SelectedItem="{Binding SelectedNetwork}"
                                                  ToolTip="この拠点のぶんだけ出します。「全拠点」を入れると絞りません。">
                                            <!-- 閉じているときの表示に DisplayMemberPath は効かない -->
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <CheckBox Content="全拠点" IsChecked="{Binding AllNetworks}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  ToolTip="拠点で絞らずに、組織のぶんをすべて出します。" />
                                        <!-- 重い取得はこのタブに閉じる（2026-08-18 ユーザー指示） -->
                                        <Button Content="取得" Command="{Binding FetchDevicesCommand}" Margin="0,0,6,0"
                                                ToolTip="機器の一覧・稼働状況・ファームの版と、MX の LAN アドレスを取ります。MX のある拠点の数だけ問い合わせるので、少し時間がかかります。" />
                                        <Button Content="Excel で保存" Command="{Binding SaveXlsxCommand}"
                                                CommandParameter="devices" Margin="0,0,6,0"
                                                ToolTip="絞り込みと見出し行の固定を付けた .xlsx で保存します。" />
                                        <Button Content="CSV で保存" Command="{Binding SaveDevicesCommand}" />
                                    </StackPanel>

                                    <Border Background="{DynamicResource Brush.Surface}"
                                            BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                            CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" Margin="4,0,18,3" Background="Transparent" Tag="mdev" MouseLeftButtonDown="OnTableHeaderSort"
                                      Cursor="Hand" ToolTip="クリックで並べ替え（もう一度で逆順）">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mdev.1]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mdev.2]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mdev.3]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mdev.4]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mdev.5]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mdev.6]}" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="5" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <TextBlock Grid.Column="0" Text="名前" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="1" Text="型番" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="2" Text="シリアル" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="3" Text="ファーム" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="4" Text="ネットワーク" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="5" Text="状態" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="6" Text="LAN IP" Style="{StaticResource Caption}" />
                                                <!-- 列幅のつまみ。星列より左は右端、右は左端の境界に置く -->
                                                <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                                       Tag="mdev.1" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                                <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                                       Tag="mdev.2" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                                <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                                       Tag="mdev.3" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                                <Thumb Grid.Column="4" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                                       Tag="mdev.4" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                                <Thumb Grid.Column="5" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                                       Tag="mdev.5" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                                <Thumb Grid.Column="6" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                                       Tag="mdev.6" DragStarted="OnTableColumnGrab" DragDelta="OnTableColumnResize" />
                                            </Grid>
                                            <Border DockPanel.Dock="Top" Height="1"
                                                    Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />

                                            <Grid>
                                            <ListBox x:Name="MerakiDeviceList" ItemsSource="{Binding DeviceRows}"
                                                     ItemContainerStyle="{StaticResource PlainRowContainer}"
                                                     Background="Transparent" BorderThickness="0"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling"
